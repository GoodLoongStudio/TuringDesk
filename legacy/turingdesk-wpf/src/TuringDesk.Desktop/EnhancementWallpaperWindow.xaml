<Window x:Class="TuringDesk.Desktop.EnhancementWallpaperWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:TuringDesk.Desktop"
        Title="TuringDesk Desktop Engine"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        ShowActivated="False"
        Focusable="False"
        AllowsTransparency="False"
        Background="#080A10">
    <Grid x:Name="SceneRoot" ClipToBounds="True">
        <local:SceneRendererControl x:Name="Renderer"/>
    </Grid>
</Window>
