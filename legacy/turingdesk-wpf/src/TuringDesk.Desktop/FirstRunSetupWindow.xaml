<Window x:Class="TuringDesk.Desktop.FirstRunSetupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:TuringDesk.Desktop"
        Title="欢迎使用 TuringDesk"
        Width="980" Height="690"
        MinWidth="860" MinHeight="620"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        ResizeMode="CanResize"
        Background="#0B0E14"
        Foreground="#F2F5FB"
        FontFamily="Segoe UI Variable, Segoe UI">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="64"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="78"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#10141C" BorderBrush="#273043" BorderThickness="0,0,0,1" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
            <Grid Margin="22,0,16,0">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="34" Height="34" CornerRadius="17" Background="#6575EE" Margin="0,0,12,0">
                        <Grid><Ellipse Width="17" Height="17" Stroke="White" StrokeThickness="1.5"/><Ellipse Width="5" Height="5" Fill="White"/></Grid>
                    </Border>
                    <StackPanel>
                        <TextBlock Text="欢迎来到 TuringDesk" FontSize="16" FontWeight="SemiBold"/>
                        <TextBlock Text="选一个桌面，连接 AI，然后就可以直接用。" Foreground="#93A0B7" FontSize="10.5" Margin="0,3,0,0"/>
                    </StackPanel>
                </StackPanel>
                <Button Grid.Column="1" Width="38" Height="34" Background="Transparent" BorderThickness="0" Click="Skip_Click" ToolTip="稍后设置">
                    <local:ShellIcon Kind="Close" Width="15" Height="15" Foreground="#9AA5B9"/>
                </Button>
            </Grid>
        </Border>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <Grid Margin="28,22,28,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.05*"/>
                    <ColumnDefinition Width="24"/>
                    <ColumnDefinition Width="0.95*"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="1  选择你的桌面" FontSize="18" FontWeight="SemiBold"/>
                    <TextBlock Text="以后随时可以在“桌面库”里换。" Foreground="#8F9AB0" FontSize="11" Margin="0,5,0,15"/>

                    <UniformGrid Columns="1">
                        <RadioButton x:Name="AuroraRadio" Tag="builtin:aurora" IsChecked="True" GroupName="Scene" Margin="0,0,0,10" Checked="Scene_Checked">
                            <Border Background="#151B27" BorderBrush="#3A4660" BorderThickness="1" CornerRadius="14" Padding="16">
                                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="84"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <Border Width="72" Height="54" CornerRadius="10">
                                        <Border.Background><RadialGradientBrush Center="0.78,0.2"><GradientStop Color="#7C6DFF" Offset="0"/><GradientStop Color="#1E3355" Offset="0.5"/><GradientStop Color="#0B1019" Offset="1"/></RadialGradientBrush></Border.Background>
                                    </Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="Aurora Flow" FontSize="14" FontWeight="SemiBold"/><TextBlock Text="柔和极光 · 日常默认" Foreground="#93A0B7" FontSize="10.5" Margin="0,4,0,0"/></StackPanel>
                                </Grid>
                            </Border>
                        </RadioButton>
                        <RadioButton x:Name="NeonRadio" Tag="builtin:neon" GroupName="Scene" Margin="0,0,0,10" Checked="Scene_Checked">
                            <Border Background="#151B27" BorderBrush="#3A4660" BorderThickness="1" CornerRadius="14" Padding="16">
                                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="84"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <Border Width="72" Height="54" CornerRadius="10">
                                        <Border.Background><LinearGradientBrush StartPoint="0,1" EndPoint="1,0"><GradientStop Color="#12091C" Offset="0"/><GradientStop Color="#5C3CFF" Offset="0.55"/><GradientStop Color="#23DCC6" Offset="1"/></LinearGradientBrush></Border.Background>
                                    </Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="Neon Grid" FontSize="14" FontWeight="SemiBold"/><TextBlock Text="霓虹网格 · 更强动态感" Foreground="#93A0B7" FontSize="10.5" Margin="0,4,0,0"/></StackPanel>
                                </Grid>
                            </Border>
                        </RadioButton>
                        <RadioButton x:Name="OrbitRadio" Tag="builtin:orbit" GroupName="Scene" Checked="Scene_Checked">
                            <Border Background="#151B27" BorderBrush="#3A4660" BorderThickness="1" CornerRadius="14" Padding="16">
                                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="84"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <Border Width="72" Height="54" CornerRadius="10" Background="#080C14">
                                        <Grid><Ellipse Width="37" Height="37" Stroke="#7385FF" StrokeDashArray="2,4"/><Ellipse Width="9" Height="9" Fill="#59DFC8" HorizontalAlignment="Center" VerticalAlignment="Center"/></Grid>
                                    </Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="Orbital Calm" FontSize="14" FontWeight="SemiBold"/><TextBlock Text="深空轨道 · 克制安静" Foreground="#93A0B7" FontSize="10.5" Margin="0,4,0,0"/></StackPanel>
                                </Grid>
                            </Border>
                        </RadioButton>
                    </UniformGrid>

                    <Border Background="#10151E" BorderBrush="#2B3448" BorderThickness="1" CornerRadius="12" Padding="14" Margin="0,16,0,0">
                        <StackPanel>
                            <TextBlock Text="你也可以直接导入自己的壁纸" FontWeight="SemiBold"/>
                            <TextBlock Text="支持图片、MP4/视频、HTML/Web 和 .tdscene 场景包。" Foreground="#8F9AB0" FontSize="10.5" Margin="0,5,0,0" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <StackPanel Grid.Column="2">
                    <TextBlock Text="2  连接 AI" FontSize="18" FontWeight="SemiBold"/>
                    <TextBlock Text="配置一次即可，搜索栏轻量对话和 AI 工作台共用同一模型。" Foreground="#8F9AB0" FontSize="11" Margin="0,5,0,15"/>

                    <Border Background="#151B27" BorderBrush="#3A4660" BorderThickness="1" CornerRadius="14" Padding="17">
                        <StackPanel>
                            <TextBlock Text="AI 来源" Foreground="#9DA8BC" FontSize="10.5"/>
                            <ComboBox x:Name="ProviderCombo" Margin="0,6,0,14" SelectionChanged="ProviderCombo_SelectionChanged">
                                <ComboBoxItem Tag="deepseek" Content="DeepSeek API（推荐）" IsSelected="True"/>
                                <ComboBoxItem Tag="ollama" Content="Ollama 本地模型"/>
                                <ComboBoxItem Tag="lmstudio" Content="LM Studio 本地模型"/>
                                <ComboBoxItem Tag="openai-compatible" Content="OpenAI 兼容 API / 中转站"/>
                            </ComboBox>

                            <TextBlock x:Name="ApiKeyLabel" Text="DeepSeek API Key" Foreground="#9DA8BC" FontSize="10.5"/>
                            <PasswordBox x:Name="ApiKeyBox" Margin="0,6,0,13" Padding="10,8" Background="#0E131B" BorderBrush="#344057" Foreground="White"/>

                            <TextBlock x:Name="BaseUrlLabel" Text="Base URL" Foreground="#9DA8BC" FontSize="10.5" Visibility="Collapsed"/>
                            <TextBox x:Name="BaseUrlBox" Margin="0,6,0,13" Padding="10,8" Background="#0E131B" BorderBrush="#344057" Foreground="White" Visibility="Collapsed"/>

                            <TextBlock Text="模型" Foreground="#9DA8BC" FontSize="10.5"/>
                            <ComboBox x:Name="ModelCombo" Margin="0,6,0,0" IsEditable="True">
                                <ComboBoxItem Content="deepseek-v4-flash" IsSelected="True"/>
                                <ComboBoxItem Content="deepseek-v4-pro"/>
                            </ComboBox>

                            <Border Background="#0F1420" CornerRadius="10" Padding="12" Margin="0,14,0,0">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal"><Ellipse Width="7" Height="7" Fill="#63E6BE" Margin="0,0,8,0"/><TextBlock Text="接好以后就这样用" FontWeight="SemiBold" FontSize="11"/></StackPanel>
                                    <TextBlock Text="Alt + Space  →  聚焦搜索栏&#x0a;输入文字  →  应用 / 文件搜索或轻量对话&#x0a;点击麦克风  →  语音输入&#x0a;点击深度处理  →  进入 AI 工作台" Foreground="#AAB5C8" FontSize="11" LineHeight="20" Margin="0,8,0,0"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Border>

                    <TextBlock x:Name="StatusText" Text="" Foreground="#F2B56B" FontSize="10.5" TextWrapping="Wrap" Margin="2,12,0,0"/>
                </StackPanel>
            </Grid>
        </ScrollViewer>

        <Border Grid.Row="2" Background="#10141C" BorderBrush="#273043" BorderThickness="0,1,0,0">
            <Grid Margin="28,0">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <TextBlock VerticalAlignment="Center" Foreground="#7E8A9F" FontSize="10.5" Text="设置以后都能改，不会锁死。"/>
                <Button Grid.Column="1" Content="稍后连接 AI" Click="SkipAi_Click" Margin="0,0,10,0" Padding="16,9" VerticalAlignment="Center"/>
                <Button x:Name="FinishButton" Grid.Column="2" Content="完成并开始使用" Click="Finish_Click" Padding="18,9" VerticalAlignment="Center" Background="#6575EE" BorderBrush="#7F8CFF" Foreground="White" FontWeight="SemiBold"/>
            </Grid>
        </Border>
    </Grid>
</Window>
