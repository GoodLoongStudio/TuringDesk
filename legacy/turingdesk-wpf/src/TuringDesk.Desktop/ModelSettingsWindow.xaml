<Window x:Class="TuringDesk.Desktop.ModelSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:TuringDesk.Desktop"
        Title="TuringDesk · 模型配置中心"
        Width="660" Height="650"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{StaticResource WindowBrush}"
        Foreground="{StaticResource TextBrush}"
        FontFamily="Segoe UI Variable, Segoe UI">
    <Grid Margin="22">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="4,2,4,18">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel>
                <StackPanel Orientation="Horizontal"><local:ShellIcon Kind="Agent" Width="20" Height="20" Foreground="{StaticResource AccentBrush}" Margin="0,2,9,0"/><TextBlock Text="模型配置中心" FontSize="24" FontWeight="SemiBold"/></StackPanel>
                <TextBlock Text="TuringDesk L3 与 DeepSeek Harness 共用这一份模型配置。L3 直接调用模型 API，Harness 读取同步后的同一份 Provider、Base URL、Model 与凭据。" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="29,6,0,0"/>
            </StackPanel>
            <Border Grid.Column="1" Background="{StaticResource AccentSoftBrush}" CornerRadius="16" Padding="10,5" VerticalAlignment="Top"><StackPanel Orientation="Horizontal"><local:ShellIcon Kind="Lock" Width="13" Height="13" Foreground="{StaticResource AccentBrush}" Margin="0,0,6,0"/><TextBlock Text="本机安全存储" Foreground="{StaticResource AccentBrush}" FontSize="11" FontWeight="SemiBold"/></StackPanel></Border>
        </Grid>

        <Border Grid.Row="1" Style="{StaticResource CardBorderStyle}" Padding="20">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <Border Background="{StaticResource AccentSoftBrush}" CornerRadius="10" Padding="13" Margin="0,0,0,18"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="28"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="1" Foreground="{StaticResource AccentBrush}" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Top"/><StackPanel Grid.Column="1"><TextBlock Text="选择当前模型" FontWeight="SemiBold"/><TextBlock Text="DeepSeek 可直接粘贴 API Key；Ollama / LM Studio 可连接本地模型；也支持任意 OpenAI-compatible API。保存后顶部搜索与 Harness 同步使用。" Foreground="{StaticResource MutedBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,4,0,0"/></StackPanel></Grid></Border>
                    <TextBlock Text="提供商" FontSize="12" FontWeight="SemiBold" Margin="2,0,0,6"/>
                    <ComboBox x:Name="ProviderBox" Height="40" SelectionChanged="ProviderBox_SelectionChanged" DisplayMemberPath="Name" Margin="0,0,0,5"/>
                    <TextBlock x:Name="ProviderHint" Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="2,0,0,16" TextWrapping="Wrap"/>
                    <TextBlock Text="API Key" FontSize="12" FontWeight="SemiBold" Margin="2,0,0,6"/>
                    <PasswordBox x:Name="ApiKeyBox" Height="40" Padding="11,8" Background="{StaticResource Surface2Brush}" Foreground="{StaticResource TextBrush}" BorderBrush="{StaticResource StrokeBrush}" BorderThickness="1"/>
                    <TextBlock Text="Ollama / LM Studio 通常可以留空。Key 会保存在本机安全存储，并同步到 Harness 的可写凭据存储。" Foreground="{StaticResource MutedBrush}" FontSize="11" TextWrapping="Wrap" Margin="2,5,0,16"/>
                    <Border Height="1" Background="{StaticResource StrokeBrush}" Margin="0,0,0,16"/>
                    <TextBlock Text="模型参数" FontSize="12" FontWeight="SemiBold" Margin="2,0,0,10"/>
                    <TextBlock Text="Base URL" FontSize="11" Foreground="{StaticResource MutedBrush}" Margin="2,0,0,5"/>
                    <TextBox x:Name="BaseUrlBox" Height="40" Padding="11,8" Margin="0,0,0,12"/>
                    <TextBlock Text="模型 ID" FontSize="11" Foreground="{StaticResource MutedBrush}" Margin="2,0,0,5"/>
                    <TextBox x:Name="ModelBox" Height="40" Padding="11,8" ToolTip="例如 DeepSeek 模型 ID、本地模型名或中转站提供的模型 ID"/>
                    <Border Background="{StaticResource Surface2Brush}" BorderBrush="{StaticResource StrokeBrush}" BorderThickness="1" CornerRadius="9" Padding="12" Margin="0,16,0,0"><StackPanel><StackPanel Orientation="Horizontal"><local:ShellIcon Kind="Info" Width="14" Height="14" Foreground="{StaticResource AccentBrush}" Margin="0,0,6,0"/><TextBlock Text="连接状态" FontSize="11" FontWeight="SemiBold"/></StackPanel><TextBlock x:Name="StatusText" Text="测试连接会由 TuringDesk 原生 HttpClient 直接请求模型 API，不会启动 Harness。" Foreground="{StaticResource MutedBrush}" FontSize="11" TextWrapping="Wrap" Margin="0,4,0,0"/></StackPanel></Border>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <Grid Grid.Row="2" Margin="0,16,0,0">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <Button Width="112" Click="Test_Click" HorizontalAlignment="Left"><StackPanel Orientation="Horizontal"><local:ShellIcon Kind="Network" Width="14" Height="14" Margin="0,0,6,0"/><TextBlock Text="测试连接"/></StackPanel></Button>
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button Width="86" IsCancel="True" Margin="0,0,8,0"><StackPanel Orientation="Horizontal"><local:ShellIcon Kind="Close" Width="13" Height="13" Margin="0,0,5,0"/><TextBlock Text="取消"/></StackPanel></Button>
                <Button Width="126" Click="Save_Click" Style="{StaticResource PrimaryButtonStyle}"><StackPanel Orientation="Horizontal"><local:ShellIcon Kind="Success" Width="14" Height="14" Margin="0,0,6,0"/><TextBlock Text="保存并应用"/></StackPanel></Button>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
