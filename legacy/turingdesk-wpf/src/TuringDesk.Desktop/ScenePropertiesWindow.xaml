<Window x:Class="TuringDesk.Desktop.ScenePropertiesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:TuringDesk.Desktop"
        Title="桌面属性"
        Width="520" Height="700"
        MinWidth="450" MinHeight="560"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        ResizeMode="CanResize"
        Background="#0B0F16"
        Foreground="#EEF2F8"
        FontFamily="Segoe UI Variable, Segoe UI">
    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="58"/><RowDefinition Height="*"/><RowDefinition Height="70"/></Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#111620" BorderBrush="#293347" BorderThickness="0,0,0,1" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
            <Grid Margin="16,0,10,0">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="31" Height="31" CornerRadius="9" Background="#263154" Margin="0,0,10,0"><local:ShellIcon Kind="Settings" Width="16" Height="16" Foreground="#A1ACFF" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                    <StackPanel><TextBlock x:Name="TitleText" Text="桌面属性" FontSize="14" FontWeight="SemiBold"/><TextBlock x:Name="KindText" Foreground="#8490A5" FontSize="9.5"/></StackPanel>
                </StackPanel>
                <Button Grid.Column="1" Width="38" Height="34" Background="Transparent" BorderThickness="0" Click="Close_Click"><local:ShellIcon Kind="Close" Width="15" Height="15" Foreground="#9EA8BB"/></Button>
            </Grid>
        </Border>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="18">
                <Border Background="#111720" BorderBrush="#2C364A" BorderThickness="1" CornerRadius="13" Padding="15" Margin="0,0,0,12">
                    <StackPanel>
                        <TextBlock Text="播放" FontWeight="SemiBold"/>
                        <TextBlock Text="FPS 上限" Foreground="#8E9AAF" FontSize="10" Margin="0,11,0,4"/>
                        <Slider x:Name="FpsSlider" Minimum="1" Maximum="240" TickFrequency="1" IsSnapToTickEnabled="True" ValueChanged="FpsSlider_ValueChanged"/>
                        <TextBlock x:Name="FpsValueText" Text="60 FPS" Foreground="#8E9AAF" FontSize="9.5" Margin="0,3,0,8"/>
                        <CheckBox x:Name="MutedCheck" Content="静音" Margin="0,2,0,7" Checked="MutedCheck_Changed" Unchecked="MutedCheck_Changed"/>
                        <TextBlock Text="音量" Foreground="#8E9AAF" FontSize="10"/><Slider x:Name="VolumeSlider" Minimum="0" Maximum="1" TickFrequency="0.05" ValueChanged="VolumeSlider_ValueChanged"/>
                        <TextBlock x:Name="VolumeValueText" Text="0%" Foreground="#8E9AAF" FontSize="9.5" Margin="0,3,0,0"/>
                    </StackPanel>
                </Border>

                <TextBlock Text="场景属性" FontSize="15" FontWeight="SemiBold" Margin="2,2,0,10"/>
                <TextBlock x:Name="EmptyText" Text="这个桌面没有提供可调属性。" Foreground="#8591A5" FontSize="10.5" Margin="2,0,0,8"/>
                <StackPanel x:Name="PropertyPanel"/>
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="2" Background="#111620" BorderBrush="#293347" BorderThickness="0,1,0,0">
            <Grid Margin="18,0">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <TextBlock x:Name="StatusText" Text="修改后点击保存，当前桌面会立即更新。" Foreground="#7F8B9E" FontSize="9.5" VerticalAlignment="Center"/>
                <Button Grid.Column="1" Content="恢复默认" Click="Reset_Click" Padding="14,7" Margin="0,0,8,0" VerticalAlignment="Center"/>
                <Button Grid.Column="2" Content="保存并应用" Click="Save_Click" Padding="16,7" VerticalAlignment="Center" Background="#6575EE" BorderBrush="#7D8AFF" Foreground="White" FontWeight="SemiBold"/>
            </Grid>
        </Border>
    </Grid>
</Window>
