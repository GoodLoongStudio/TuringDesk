<Window x:Class="TuringDesk.Desktop.TaskSwitcherWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:TuringDesk.Desktop"
        Title="TuringDesk Task Switcher"
        Width="760" Height="470"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        Background="#11141B"
        Foreground="{StaticResource TextBrush}"
        FontFamily="Segoe UI Variable, Segoe UI"
        KeyDown="Window_KeyDown">
    <Border Background="#11141B" BorderBrush="#35405B" BorderThickness="1" CornerRadius="18" Padding="18">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid Margin="0,0,0,14">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal">
                    <Border Width="38" Height="38" CornerRadius="11" Background="#232A3A" Margin="0,0,11,0">
                        <local:ShellIcon Kind="Tasks" Width="20" Height="20" Foreground="#9DAAFF" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel>
                        <TextBlock Text="任务切换" FontSize="22" FontWeight="SemiBold"/>
                        <TextBlock Text="选择一个正在运行的窗口。Windows 原生 Alt+Tab 保持不变。" Foreground="#8F9AB0" FontSize="11" Margin="0,4,0,0"/>
                    </StackPanel>
                </StackPanel>
                <Button Grid.Column="1" Width="38" Height="38" Padding="0" Click="Close_Click" ToolTip="关闭">
                    <local:ShellIcon Kind="Close" Width="16" Height="16" Foreground="#B7C0D2"/>
                </Button>
            </Grid>

            <ListBox Grid.Row="1" x:Name="TasksList" ItemsSource="{Binding Tasks}" Background="Transparent" BorderThickness="0" MouseDoubleClick="TasksList_MouseDoubleClick">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Margin" Value="0,0,0,5"/>
                        <Setter Property="Padding" Value="0"/>
                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                        <Setter Property="Background" Value="Transparent"/>
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Button Tag="{Binding Handle}" Click="Task_Click" Height="54" HorizontalContentAlignment="Stretch" Padding="10,0">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="42"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <Grid Width="30" Height="30" VerticalAlignment="Center">
                                    <Image Source="{Binding Icon}" Width="28" Height="28" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/>
                                    <local:ShellIcon Kind="App" Width="21" Height="21" Foreground="#9DAAFF" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <local:ShellIcon.Style>
                                            <Style TargetType="local:ShellIcon"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Icon}" Value="{x:Null}"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style>
                                        </local:ShellIcon.Style>
                                    </local:ShellIcon>
                                </Grid>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" FontSize="12.5" FontWeight="SemiBold"/>
                                    <TextBlock Text="{Binding ProcessName}" Foreground="#7F8AA0" FontSize="10" Margin="0,2,0,0"/>
                                </StackPanel>
                                <TextBlock Grid.Column="2" Text="{Binding MonitorLabel}" Foreground="#7F8AA0" FontSize="10" VerticalAlignment="Center" Margin="10,0,2,0"/>
                            </Grid>
                        </Button>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <TextBlock Grid.Row="2" Text="Enter 切换 · Esc 关闭 · Ctrl+Alt+Space 可从 Shell 打开" Foreground="#7F8AA0" FontSize="10" Margin="2,12,0,0"/>
        </Grid>
    </Border>
</Window>
