<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>TuringDesk.ShellHost</AssemblyName>
    <RootNamespace>TuringDesk.ShellHost</RootNamespace>
    <TuringDeskApplicationIcon>$(MSBuildProjectDirectory)\$(IntermediateOutputPath)TuringDesk.ico</TuringDeskApplicationIcon>
    <ApplicationIcon>$(TuringDeskApplicationIcon)</ApplicationIcon>
  </PropertyGroup>

  <Target Name="GenerateTuringDeskApplicationIcon"
          BeforeTargets="CoreCompile"
          Inputs="$(MSBuildProjectDirectory)\..\..\scripts\generate-brand-icon.ps1"
          Outputs="$(TuringDeskApplicationIcon)">
    <Exec Command="powershell.exe -NoProfile -ExecutionPolicy Bypass -File &quot;$(MSBuildProjectDirectory)\..\..\scripts\generate-brand-icon.ps1&quot; -OutputPath &quot;$(TuringDeskApplicationIcon)&quot;" />
  </Target>
</Project>
