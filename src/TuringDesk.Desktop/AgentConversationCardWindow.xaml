<Window x:Class="TuringDesk.Desktop.AgentConversationCardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:TuringDesk.Desktop"
        Title="TuringDesk Agent Conversation"
        Width="410" Height="292"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        AllowsTransparency="True"
        Background="Transparent"
        Foreground="{StaticResource TextBrush}"
        FontFamily="Segoe UI Variable, Segoe UI">
    <Border x:Name="CardRoot" Background="#F2171B25" BorderBrush="{StaticResource AccentBrush}" BorderThickness="1" CornerRadius="16" Padding="14">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="30" Height="30" CornerRadius="9" Background="{StaticResource AccentSoftBrush}" Margin="0,0,9,0"><local:ShellIcon Kind="Agent" Width="17" Height="17" Foreground="{StaticResource AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                    <StackPanel>
                        <TextBlock Text="图灵对话" FontWeight="SemiBold" FontSize="13.5"/>
                        <TextBlock x:Name="StatusText" Text="正在执行" Foreground="{StaticResource MutedBrush}" FontSize="10.5"/>
                    </StackPanel>
                </StackPanel>
                <Button Grid.Column="1" Width="32" Height="30" Padding="0" Click="Close_Click" ToolTip="关闭"><local:ShellIcon Kind="Close" Width="14" Height="14" Foreground="#B7C0D2"/></Button>
            </Grid>

            <Border Grid.Row="1" Background="#A0202530" BorderBrush="#344057" BorderThickness="1" CornerRadius="10" Padding="9" Margin="0,12,0,9">
                <StackPanel>
                    <TextBlock Text="你的请求" Foreground="#8F9BAF" FontSize="9.5" Margin="2,0,0,4"/>
                    <TextBox x:Name="PromptBox" Background="Transparent" BorderThickness="0" Foreground="#E9EDF5" TextWrapping="Wrap" AcceptsReturn="True" MaxHeight="60" VerticalScrollBarVisibility="Auto" FontSize="11.5" Padding="2" ToolTip="文本可选择、复制和粘贴"/>
                </StackPanel>
            </Border>

            <Border Grid.Row="2" Background="#8F10141C" BorderBrush="#303A4E" BorderThickness="1" CornerRadius="10" Padding="9">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <TextBlock Text="图灵回复" Foreground="#8F9BAF" FontSize="9.5" Margin="2,0,0,5"/>
                    <TextBox Grid.Row="1" x:Name="ReplyBox" Background="Transparent" BorderThickness="0" Foreground="#D9E0ED" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" FontSize="11.5" Padding="2" ToolTip="可以直接复制、修改或粘贴文本"/>
                </Grid>
            </Border>

            <Grid Grid.Row="3" Margin="0,10,0,0">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <TextBlock x:Name="RunText" Text="Run --" Foreground="#758197" FontSize="9.5" VerticalAlignment="Center"/>
                <Button Grid.Column="1" Padding="10,5" Margin="0,0,6,0" Click="Paste_Click"><StackPanel Orientation="Horizontal"><local:ShellIcon Kind="Paste" Width="13" Height="13" Foreground="#B7C0D2" Margin="0,0,5,0"/><TextBlock Text="粘贴"/></StackPanel></Button>
                <Button Grid.Column="2" Padding="10,5" Click="CopyAll_Click"><StackPanel Orientation="Horizontal"><local:ShellIcon Kind="Copy" Width="13" Height="13" Foreground="#B7C0D2" Margin="0,0,5,0"/><TextBlock Text="复制全部"/></StackPanel></Button>
            </Grid>
        </Grid>
    </Border>
</Window>
