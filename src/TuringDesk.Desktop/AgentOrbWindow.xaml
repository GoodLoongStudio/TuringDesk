<Window x:Class="TuringDesk.Desktop.AgentOrbWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:TuringDesk.Desktop"
        Title="TuringDesk AI Orb"
        Width="76" Height="76"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        ShowActivated="False"
        Topmost="True"
        FontFamily="Segoe UI Variable, Segoe UI">
    <Window.Resources>
        <Storyboard x:Key="OrbPulse" RepeatBehavior="Forever" AutoReverse="True">
            <DoubleAnimation Storyboard.TargetName="OrbHalo" Storyboard.TargetProperty="Opacity" From="0.28" To="0.62" Duration="0:0:1.8"/>
            <DoubleAnimation Storyboard.TargetName="OrbScale" Storyboard.TargetProperty="ScaleX" From="0.96" To="1.06" Duration="0:0:1.8"/>
            <DoubleAnimation Storyboard.TargetName="OrbScale" Storyboard.TargetProperty="ScaleY" From="0.96" To="1.06" Duration="0:0:1.8"/>
        </Storyboard>
    </Window.Resources>

    <Grid>
        <Border x:Name="ComposerPanel"
                Visibility="Collapsed"
                HorizontalAlignment="Left"
                VerticalAlignment="Bottom"
                Width="372"
                Height="146"
                Margin="0,0,76,0"
                CornerRadius="22"
                Background="#F2151922"
                BorderBrush="#46536D"
                BorderThickness="1"
                Padding="16">
            <Border.Effect>
                <DropShadowEffect BlurRadius="28" ShadowDepth="7" Opacity="0.38" Color="#000000"/>
            </Border.Effect>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Ellipse Width="7" Height="7" Fill="#63E6BE" Margin="0,0,8,0"/>
                        <TextBlock Text="TURING DESK" Foreground="#AEB9CE" FontWeight="SemiBold" FontSize="10"/>
                        <TextBlock x:Name="HotkeyHint" Text="  ALT + SPACE" Foreground="#66738B" FontSize="9.5"/>
                    </StackPanel>
                    <Button Grid.Column="1" Width="26" Height="24" Padding="0" Background="Transparent" BorderThickness="0" Click="Collapse_Click" ToolTip="收起">
                        <local:ShellIcon Kind="Close" Width="13" Height="13" Foreground="#8F9AB0"/>
                    </Button>
                </Grid>

                <TextBox x:Name="ComposerBox"
                         Grid.Row="1"
                         Margin="0,10,0,9"
                         Padding="11,9"
                         Background="#C90C1017"
                         BorderBrush="#354159"
                         BorderThickness="1"
                         Foreground="#F3F6FC"
                         CaretBrush="#95A2FF"
                         FontSize="14"
                         TextWrapping="Wrap"
                         AcceptsReturn="False"
                         VerticalContentAlignment="Center"
                         KeyDown="ComposerBox_KeyDown"
                         ToolTip="描述你想让桌面完成的事情"/>

                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal">
                        <Button Height="27" Padding="9,0" Margin="0,0,6,0" Click="Diy_Click" Background="#151B25" BorderBrush="#2D384D" Foreground="#AEB8CB" ToolTip="导入、选择并应用完整桌面场景">
                            <StackPanel Orientation="Horizontal"><local:ShellIcon Kind="Wallpaper" Width="13" Height="13" Foreground="#AEB8CB" Margin="0,0,5,0"/><TextBlock Text="桌面库" FontSize="10.5"/></StackPanel>
                        </Button>
                        <Button Height="27" Padding="9,0" Margin="0,0,6,0" Click="ControlCenter_Click" Background="#151B25" BorderBrush="#2D384D" Foreground="#7F8B9F" ToolTip="模型、桌面与高级设置">
                            <StackPanel Orientation="Horizontal"><local:ShellIcon Kind="Settings" Width="13" Height="13" Foreground="#7F8B9F" Margin="0,0,5,0"/><TextBlock Text="设置" FontSize="10.5"/></StackPanel>
                        </Button>
                        <Button Height="27" Padding="8,0" Click="Exit_Click" Background="#151B25" BorderBrush="#2D384D" Foreground="#78849A" ToolTip="退出 TuringDesk">
                            <local:ShellIcon Kind="Power" Width="13" Height="13" Foreground="#78849A"/>
                        </Button>
                    </StackPanel>

                    <Button Grid.Column="1" Width="72" Height="29" Click="Send_Click" Background="#6F7DFF" BorderBrush="#8793FF" Foreground="White" FontWeight="SemiBold">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center"><TextBlock Text="发送" FontSize="11"/><TextBlock Text="  ↵" FontSize="11" Foreground="#DCE0FF"/></StackPanel>
                    </Button>
                </Grid>
            </Grid>
        </Border>

        <Grid x:Name="OrbHost" Width="68" Height="68" HorizontalAlignment="Right" VerticalAlignment="Bottom">
            <Ellipse x:Name="OrbHalo" Width="68" Height="68" Opacity="0.42" IsHitTestVisible="False">
                <Ellipse.RenderTransform>
                    <ScaleTransform x:Name="OrbScale" CenterX="34" CenterY="34"/>
                </Ellipse.RenderTransform>
                <Ellipse.Fill>
                    <RadialGradientBrush>
                        <GradientStop Color="#C77B8AFF" Offset="0"/>
                        <GradientStop Color="#6A5A6BFF" Offset="0.52"/>
                        <GradientStop Color="#0040508C" Offset="1"/>
                    </RadialGradientBrush>
                </Ellipse.Fill>
                <Ellipse.Effect><BlurEffect Radius="10"/></Ellipse.Effect>
            </Ellipse>

            <Button Width="54" Height="54" HorizontalAlignment="Center" VerticalAlignment="Center" Click="Orb_Click" ToolTip="TuringDesk · Alt+Space" Padding="0" BorderThickness="1" BorderBrush="#7E8CFF">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border CornerRadius="27" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                            <Border.Background>
                                <RadialGradientBrush Center="0.36,0.28" GradientOrigin="0.36,0.28">
                                    <GradientStop Color="#FF98A4FF" Offset="0"/>
                                    <GradientStop Color="#FF6575EE" Offset="0.42"/>
                                    <GradientStop Color="#FF293452" Offset="1"/>
                                </RadialGradientBrush>
                            </Border.Background>
                            <Grid>
                                <Ellipse Width="24" Height="24" Stroke="#F7F8FF" StrokeThickness="1.7" Opacity="0.96"/>
                                <Ellipse Width="7" Height="7" Fill="#F8FAFF" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                <Ellipse Width="3" Height="3" Fill="#91F4D5" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,15,14,0"/>
                            </Grid>
                        </Border>
                    </ControlTemplate>
                </Button.Template>
            </Button>
        </Grid>
    </Grid>
</Window>
