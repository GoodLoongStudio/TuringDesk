<UserControl x:Class="TuringDesk.Desktop.AgentStatusBadge"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="Segoe UI Variable, Segoe UI">
    <Button Padding="5,0" Click="Status_Click" ToolTip="打开图灵执行中心">
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
            <Border x:Name="StatusDot" Width="7" Height="7" CornerRadius="4" Background="#7D899D" VerticalAlignment="Center" Margin="0,0,5,0"/>
            <TextBlock x:Name="StatusText" Text="图灵" FontSize="10.5" VerticalAlignment="Center"/>
        </StackPanel>
    </Button>
</UserControl>
