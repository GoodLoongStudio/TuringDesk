<Window x:Class="TuringDesk.Desktop.AgentTraceCardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:TuringDesk.Desktop"
        Title="TuringDesk Agent Trace"
        Width="360" Height="292"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        AllowsTransparency="True"
        Background="Transparent"
        Foreground="{StaticResource TextBrush}"
        FontFamily="Segoe UI Variable, Segoe UI">
    <Border x:Name="CardRoot" Background="#F2161A22" BorderBrush="#4A566C" BorderThickness="1" CornerRadius="16" Padding="14">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="30" Height="30" CornerRadius="9" Background="#242B38" Margin="0,0,9,0"><local:ShellIcon Kind="Tasks" Width="17" Height="17" Foreground="#B7C1D4" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                    <StackPanel>
                        <TextBlock Text="执行轨迹" FontWeight="SemiBold" FontSize="13.5"/>
                        <TextBlock x:Name="KernelText" Text="DeepSeek Harness" Foreground="{StaticResource MutedBrush}" FontSize="10.5"/>
                    </StackPanel>
                </StackPanel>
                <Button Grid.Column="1" Width="32" Height="30" Padding="0" Click="Close_Click" ToolTip="关闭"><local:ShellIcon Kind="Close" Width="14" Height="14" Foreground="#B7C0D2"/></Button>
            </Grid>

            <Border Grid.Row="1" Background="#9A202631" CornerRadius="9" Padding="9,6" Margin="0,12,0,8">
                <Grid><TextBlock x:Name="PhaseText" Text="等待 Agent 执行" FontSize="10.5"/><TextBlock x:Name="ElapsedText" HorizontalAlignment="Right" Foreground="#8792A7" FontSize="9.5"/></Grid>
            </Border>

            <TextBox Grid.Row="2" x:Name="TraceBox" Background="#8C0F131A" BorderBrush="#30394B" BorderThickness="1" Foreground="#C9D2E2" Padding="10" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" FontFamily="Cascadia Mono, Consolas" FontSize="10.5" ToolTip="轨迹文本可以选择、复制、编辑和粘贴"/>

            <Grid Grid.Row="3" Margin="0,10,0,0">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <TextBlock Text="真实 Harness / MCP 事件会逐步刷新" Foreground="#758197" FontSize="9.5" VerticalAlignment="Center"/>
                <Button Grid.Column="1" Padding="10,5" Margin="0,0,6,0" Click="Paste_Click"><StackPanel Orientation="Horizontal"><local:ShellIcon Kind="Paste" Width="13" Height="13" Foreground="#B7C0D2" Margin="0,0,5,0"/><TextBlock Text="粘贴"/></StackPanel></Button>
                <Button Grid.Column="2" Padding="10,5" Click="Copy_Click"><StackPanel Orientation="Horizontal"><local:ShellIcon Kind="Copy" Width="13" Height="13" Foreground="#B7C0D2" Margin="0,0,5,0"/><TextBlock Text="复制"/></StackPanel></Button>
            </Grid>
        </Grid>
    </Border>
</Window>
