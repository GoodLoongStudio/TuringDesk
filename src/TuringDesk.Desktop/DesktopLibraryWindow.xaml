<Window x:Class="TuringDesk.Desktop.DesktopLibraryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:TuringDesk.Desktop"
        Title="TuringDesk 桌面库"
        Width="1180" Height="780"
        MinWidth="980" MinHeight="660"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="CanResize"
        Background="#0A0D13"
        Foreground="#EEF2F8"
        FontFamily="Segoe UI Variable, Segoe UI"
        AllowDrop="True"
        DragOver="Window_DragOver"
        Drop="Window_Drop">
    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="60"/><RowDefinition Height="*"/></Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#10141C" BorderBrush="#283144" BorderThickness="0,0,0,1" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
            <Grid Margin="18,0,12,0">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="32" Height="32" CornerRadius="9" Background="#273153" Margin="0,0,10,0">
                        <local:ShellIcon Kind="Desktop" Width="17" Height="17" Foreground="#9CA8FF" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel><TextBlock Text="TuringDesk 桌面库" FontSize="15" FontWeight="SemiBold"/><TextBlock Text="动态桌面 · 播放列表 · 应用规则 · AI" Foreground="#8E99AE" FontSize="10"/></StackPanel>
                </StackPanel>
                <Button Grid.Column="1" Content="＋ 导入壁纸" Click="Import_Click" Margin="0,0,8,0" Padding="12,6" VerticalAlignment="Center"/>
                <Button Grid.Column="2" Width="38" Height="34" Background="Transparent" BorderThickness="0" Click="Close_Click" ToolTip="关闭">
                    <local:ShellIcon Kind="Close" Width="15" Height="15" Foreground="#9EA8BB"/>
                </Button>
            </Grid>
        </Border>

        <TabControl Grid.Row="1" x:Name="Tabs" Background="#0A0D13" BorderThickness="0" Padding="14">
            <TabItem Header="已安装">
                <Grid Margin="8,14,8,8">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="20"/><ColumnDefinition Width="320"/></Grid.ColumnDefinitions>
                    <Grid>
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                        <Grid Margin="0,0,0,12"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <StackPanel><TextBlock Text="你的桌面" FontSize="21" FontWeight="SemiBold"/><TextBlock Text="直接把图片、视频、HTML 或 .tdscene 拖进这个窗口。" Foreground="#8F9BAF" FontSize="11" Margin="0,4,0,0"/></StackPanel>
                            <TextBox Grid.Column="1" x:Name="SearchBox" Width="220" Height="34" Margin="12,0,0,0" TextChanged="SearchBox_TextChanged" ToolTip="搜索桌面"/>
                        </Grid>
                        <ListBox Grid.Row="1" x:Name="SceneList" SelectionChanged="SceneList_SelectionChanged" Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListBox.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ListBox.ItemsPanel>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border Width="238" Height="158" Margin="0,0,12,12" CornerRadius="14" Background="#131923" BorderBrush="#303A4E" BorderThickness="1" Padding="13">
                                        <Grid>
                                            <Grid.RowDefinitions><RowDefinition Height="78"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                                            <Border CornerRadius="10" Background="#19243A">
                                                <Grid>
                                                    <Rectangle Fill="#111722"/>
                                                    <Ellipse Width="96" Height="96" Fill="#4A6375FF" Opacity="0.34" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-36,-24,0"><Ellipse.Effect><BlurEffect Radius="18"/></Ellipse.Effect></Ellipse>
                                                    <TextBlock Text="{Binding Kind}" Foreground="#AEB9D0" FontSize="10" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="9"/>
                                                </Grid>
                                            </Border>
                                            <StackPanel Grid.Row="1" Margin="1,9,1,0">
                                                <TextBlock Text="{Binding Title}" FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Text="{Binding Description}" Foreground="#8793A8" FontSize="9.8" TextTrimming="CharacterEllipsis" Margin="0,4,0,0"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>

                    <Border Grid.Column="2" Background="#111720" BorderBrush="#2D374A" BorderThickness="1" CornerRadius="15" Padding="17">
                        <StackPanel>
                            <TextBlock x:Name="SelectedTitle" Text="选择一个桌面" FontSize="18" FontWeight="SemiBold"/>
                            <TextBlock x:Name="SelectedMeta" Text="" Foreground="#8D99AE" FontSize="10.5" Margin="0,5,0,0" TextWrapping="Wrap"/>
                            <TextBlock x:Name="SelectedDescription" Text="从左边选择一个桌面，然后直接应用。" Foreground="#AAB4C6" TextWrapping="Wrap" FontSize="11" Margin="0,14,0,18"/>
                            <Button x:Name="ApplySceneButton" Content="应用到桌面" Click="ApplyScene_Click" Height="38" Background="#6575EE" BorderBrush="#7D8AFF" Foreground="White" FontWeight="SemiBold" IsEnabled="False"/>
                            <Button x:Name="ExportSceneButton" Content="导出 .tdscene" Click="ExportScene_Click" Height="34" Margin="0,8,0,0" IsEnabled="False"/>
                            <Separator Margin="0,18,0,15"/>
                            <TextBlock Text="当前场景" Foreground="#8D99AE" FontSize="10.5"/>
                            <TextBlock x:Name="CurrentSceneText" Text="-" Margin="0,5,0,0" FontWeight="SemiBold"/>
                            <TextBlock Text="提示：视频和 Web 场景会在全屏游戏时按“性能”页的规则自动暂停或释放。" Foreground="#7F8A9D" FontSize="10" TextWrapping="Wrap" Margin="0,14,0,0"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </TabItem>

            <TabItem Header="播放列表">
                <Grid Margin="12,16">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="320"/><ColumnDefinition Width="18"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="播放列表" FontSize="21" FontWeight="SemiBold"/>
                        <TextBlock Text="按时间自动轮换桌面。" Foreground="#8F9BAF" FontSize="11" Margin="0,4,0,12"/>
                        <ListBox x:Name="PlaylistList" Height="420" SelectionChanged="PlaylistList_SelectionChanged" DisplayMemberPath="Name"/>
                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0"><Button Content="新建" Click="NewPlaylist_Click" Padding="13,6"/><Button Content="删除" Click="DeletePlaylist_Click" Padding="13,6" Margin="8,0,0,0"/></StackPanel>
                    </StackPanel>
                    <Border Grid.Column="2" Background="#111720" BorderBrush="#2D374A" BorderThickness="1" CornerRadius="15" Padding="18">
                        <StackPanel>
                            <TextBlock Text="播放列表设置" FontSize="17" FontWeight="SemiBold"/>
                            <TextBlock Text="名称" Foreground="#8D99AE" FontSize="10.5" Margin="0,15,0,5"/><TextBox x:Name="PlaylistNameBox"/>
                            <TextBlock Text="场景 ID（每行一个，可从“已安装”页复制/选择）" Foreground="#8D99AE" FontSize="10.5" Margin="0,12,0,5"/><TextBox x:Name="PlaylistScenesBox" Height="160" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" TextWrapping="NoWrap"/>
                            <TextBlock Text="轮换间隔（分钟）" Foreground="#8D99AE" FontSize="10.5" Margin="0,12,0,5"/><TextBox x:Name="PlaylistIntervalBox" Text="10"/>
                            <CheckBox x:Name="PlaylistShuffleCheck" Content="随机顺序" Margin="0,12,0,0"/>
                            <CheckBox x:Name="PlaylistChangePausedCheck" Content="暂停时仍允许切换" Margin="0,7,0,0"/>
                            <StackPanel Orientation="Horizontal" Margin="0,18,0,0"><Button Content="保存" Click="SavePlaylist_Click" Padding="16,7"/><Button Content="立即使用" Click="ActivatePlaylist_Click" Padding="16,7" Margin="8,0,0,0" Background="#6575EE" Foreground="White"/></StackPanel>
                        </StackPanel>
                    </Border>
                </Grid>
            </TabItem>

            <TabItem Header="应用规则">
                <Grid Margin="12,16">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="20"/><ColumnDefinition Width="360"/></Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="应用规则" FontSize="21" FontWeight="SemiBold"/>
                        <TextBlock Text="游戏、音乐、工作软件启动时自动暂停、停止或切换桌面。" Foreground="#8F9BAF" FontSize="11" Margin="0,4,0,12"/>
                        <DataGrid x:Name="RuleGrid" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True" Height="470">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="程序" Binding="{Binding ExeName}" Width="*"/>
                                <DataGridTextColumn Header="条件" Binding="{Binding Condition}" Width="120"/>
                                <DataGridTextColumn Header="动作" Binding="{Binding Action}" Width="140"/>
                                <DataGridTextColumn Header="目标" Binding="{Binding TargetId}" Width="180"/>
                            </DataGrid.Columns>
                        </DataGrid>
                        <Button Content="删除选中规则" Click="DeleteRule_Click" Padding="13,6" HorizontalAlignment="Left" Margin="0,10,0,0"/>
                    </StackPanel>
                    <Border Grid.Column="2" Background="#111720" BorderBrush="#2D374A" BorderThickness="1" CornerRadius="15" Padding="18">
                        <StackPanel>
                            <TextBlock Text="新规则" FontSize="17" FontWeight="SemiBold"/>
                            <TextBlock Text="程序名，例如 dota2.exe" Foreground="#8D99AE" FontSize="10.5" Margin="0,15,0,5"/><TextBox x:Name="RuleExeBox"/>
                            <TextBlock Text="条件" Foreground="#8D99AE" FontSize="10.5" Margin="0,12,0,5"/><ComboBox x:Name="RuleConditionCombo"><ComboBoxItem Tag="Running" Content="程序运行时" IsSelected="True"/><ComboBoxItem Tag="Fullscreen" Content="该程序全屏时"/></ComboBox>
                            <TextBlock Text="动作" Foreground="#8D99AE" FontSize="10.5" Margin="0,12,0,5"/><ComboBox x:Name="RuleActionCombo" SelectionChanged="RuleActionCombo_SelectionChanged"><ComboBoxItem Tag="KeepRunning" Content="保持运行"/><ComboBoxItem Tag="Pause" Content="暂停" IsSelected="True"/><ComboBoxItem Tag="Stop" Content="停止并释放"/><ComboBoxItem Tag="LoadScene" Content="加载场景"/><ComboBoxItem Tag="LoadPlaylist" Content="加载播放列表"/><ComboBoxItem Tag="LoadProfile" Content="加载多屏配置"/></ComboBox>
                            <TextBlock x:Name="RuleTargetLabel" Text="目标 ID" Foreground="#8D99AE" FontSize="10.5" Margin="0,12,0,5" Visibility="Collapsed"/><TextBox x:Name="RuleTargetBox" Visibility="Collapsed"/>
                            <Button Content="添加规则" Click="AddRule_Click" Padding="15,8" Margin="0,18,0,0" Background="#6575EE" Foreground="White"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </TabItem>

            <TabItem Header="性能">
                <Grid Margin="12,16" MaxWidth="760" HorizontalAlignment="Left">
                    <StackPanel>
                        <TextBlock Text="性能" FontSize="21" FontWeight="SemiBold"/>
                        <TextBlock Text="像 Wallpaper Engine 一样，遇到游戏时主动让出 GPU/内存。" Foreground="#8F9BAF" FontSize="11" Margin="0,4,0,18"/>
                        <Border Background="#111720" BorderBrush="#2D374A" BorderThickness="1" CornerRadius="15" Padding="18">
                            <StackPanel>
                                <TextBlock Text="其他程序全屏时" FontWeight="SemiBold"/><ComboBox x:Name="FullscreenBehaviorCombo" Margin="0,7,0,15"><ComboBoxItem Tag="KeepRunning" Content="保持运行"/><ComboBoxItem Tag="Pause" Content="暂停（推荐）" IsSelected="True"/><ComboBoxItem Tag="Stop" Content="停止并释放内存"/></ComboBox>
                                <TextBlock Text="其他程序最大化时" FontWeight="SemiBold"/><ComboBox x:Name="MaximizedBehaviorCombo" Margin="0,7,0,15"><ComboBoxItem Tag="KeepRunning" Content="保持运行" IsSelected="True"/><ComboBoxItem Tag="Pause" Content="暂停"/><ComboBoxItem Tag="Stop" Content="停止并释放内存"/></ComboBox>
                                <TextBlock Text="全局 FPS 上限" FontWeight="SemiBold"/><Slider x:Name="FpsSlider" Minimum="15" Maximum="144" TickFrequency="15" IsSnapToTickEnabled="False" Margin="0,7,0,0"/><TextBlock x:Name="FpsText" Text="60 FPS" Foreground="#8D99AE" Margin="0,3,0,14"/>
                                <TextBlock Text="壁纸音量" FontWeight="SemiBold"/><Slider x:Name="VolumeSlider" Minimum="0" Maximum="1" TickFrequency="0.1" Margin="0,7,0,0"/><TextBlock x:Name="VolumeText" Text="静音" Foreground="#8D99AE" Margin="0,3,0,14"/>
                                <Button Content="保存性能设置" Click="SavePerformance_Click" Padding="15,8" HorizontalAlignment="Left"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>
            </TabItem>

            <TabItem Header="AI">
                <Grid Margin="12,16" MaxWidth="820" HorizontalAlignment="Left">
                    <StackPanel>
                        <TextBlock Text="AI" FontSize="21" FontWeight="SemiBold"/>
                        <TextBlock Text="你平时只需要 Alt+Space、Orb 或语音。" Foreground="#8F9BAF" FontSize="11" Margin="0,4,0,18"/>
                        <Border Background="#111720" BorderBrush="#2D374A" BorderThickness="1" CornerRadius="15" Padding="18" Margin="0,0,0,12">
                            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <StackPanel><TextBlock Text="模型连接" FontSize="15" FontWeight="SemiBold"/><TextBlock x:Name="AiModelText" Text="正在读取…" Foreground="#9CA8BB" FontSize="10.5" Margin="0,5,0,0"/></StackPanel>
                                <Button Grid.Column="1" Content="连接 / 更换模型" Click="ModelSettings_Click" Padding="14,7"/>
                            </Grid>
                        </Border>
                        <Border Background="#0E131B" BorderBrush="#252E40" BorderThickness="1" CornerRadius="15" Padding="18">
                            <StackPanel>
                                <TextBlock Text="高级控制台" FontSize="14" FontWeight="SemiBold"/>
                                <TextBlock Text="普通使用不需要打开。这里是 DeepSeek Harness 官方完整 WebUI，给高级用户调试 Agent、会话和工具。" Foreground="#8490A5" FontSize="10.5" TextWrapping="Wrap" Margin="0,5,0,10"/>
                                <Button Content="打开高级 Harness 控制台" Click="Harness_Click" Padding="14,7" HorizontalAlignment="Left"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</Window>
