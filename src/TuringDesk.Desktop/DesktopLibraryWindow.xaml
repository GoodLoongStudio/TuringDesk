<Window x:Class="TuringDesk.Desktop.DesktopLibraryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:TuringDesk.Desktop"
        Title="TuringDesk 设置"
        Width="980" Height="640"
        MinWidth="760" MinHeight="520"
        WindowStartupLocation="CenterScreen"
        WindowStyle="SingleBorderWindow"
        ResizeMode="CanResize"
        Background="#F5F6F8"
        Foreground="#1F2328"
        FontFamily="Segoe UI Variable, Segoe UI"
        AllowDrop="True"
        DragOver="Window_DragOver"
        Drop="Window_Drop">
    <Window.Resources>
        <local:ScenePreviewConverter x:Key="ScenePreviewBrush"/>
        <SolidColorBrush x:Key="PageBrush" Color="#F5F6F8"/>
        <SolidColorBrush x:Key="CardBrush" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="StrokeBrushLocal" Color="#D9DEE6"/>
        <SolidColorBrush x:Key="TextBrushLocal" Color="#1F2328"/>
        <SolidColorBrush x:Key="MutedBrushLocal" Color="#667085"/>
        <SolidColorBrush x:Key="AccentBrushLocal" Color="#2563EB"/>
        <SolidColorBrush x:Key="AccentHoverBrushLocal" Color="#1D4ED8"/>

        <Style TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource TextBrushLocal}"/>
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#C9D0DA"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,7"/>
            <Setter Property="MinHeight" Value="32"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="{StaticResource AccentBrushLocal}"/>
            <Setter Property="BorderBrush" Value="{StaticResource AccentBrushLocal}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="14,7"/>
            <Setter Property="MinHeight" Value="34"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrushLocal}"/>
            <Setter Property="BorderBrush" Value="#C9D0DA"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8,5"/>
            <Setter Property="CaretBrush" Value="#1F2328"/>
            <Setter Property="SelectionBrush" Value="#BFDBFE"/>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrushLocal}"/>
            <Setter Property="BorderBrush" Value="#C9D0DA"/>
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="MinHeight" Value="32"/>
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{StaticResource TextBrushLocal}"/>
        </Style>
        <Style TargetType="ListBoxItem">
            <Setter Property="Foreground" Value="{StaticResource TextBrushLocal}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        </Style>
        <Style TargetType="DataGrid">
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrushLocal}"/>
            <Setter Property="BorderBrush" Value="#D9DEE6"/>
            <Setter Property="GridLinesVisibility" Value="Horizontal"/>
            <Setter Property="HorizontalGridLinesBrush" Value="#E7EAF0"/>
            <Setter Property="RowBackground" Value="White"/>
            <Setter Property="AlternatingRowBackground" Value="#F8F9FB"/>
        </Style>
        <Style TargetType="TabControl">
            <Setter Property="Background" Value="{StaticResource PageBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrushLocal}"/>
        </Style>
        <Style TargetType="TabItem">
            <Setter Property="Foreground" Value="{StaticResource TextBrushLocal}"/>
            <Setter Property="Padding" Value="14,7"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>
    </Window.Resources>

    <Grid Background="{StaticResource PageBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="White" BorderBrush="#D9DEE6" BorderThickness="0,0,0,1" Padding="18,12">
            <DockPanel LastChildFill="True">
                <Button DockPanel.Dock="Right" Content="新建场景" Click="NewScene_Click" Margin="8,0,0,0"/>
                <Button DockPanel.Dock="Right" Content="导入壁纸" Click="Import_Click" Style="{StaticResource PrimaryButton}" Margin="8,0,0,0"/>
                <StackPanel>
                    <TextBlock Text="桌面设置" FontSize="18" FontWeight="SemiBold" Foreground="#1F2328"/>
                    <TextBlock Text="场景、播放列表、多屏、应用规则、性能和 AI" Foreground="{StaticResource MutedBrushLocal}" FontSize="11" Margin="0,3,0,0"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <TabControl Grid.Row="1" x:Name="Tabs" Margin="14" BorderThickness="0">
            <TabItem Header="已安装">
                <Grid Margin="4,14,4,4">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="290"/></Grid.ColumnDefinitions>
                    <Grid>
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="你的桌面" FontSize="20" FontWeight="SemiBold" Foreground="#1F2328"/>
                                <TextBlock Text="把图片、视频、HTML 或 .tdscene 拖进窗口即可导入。" Foreground="{StaticResource MutedBrushLocal}" FontSize="11" Margin="0,4,0,0"/>
                            </StackPanel>
                            <TextBox Grid.Column="1" x:Name="SearchBox" Width="180" Height="34" Margin="12,0,0,0" TextChanged="SearchBox_TextChanged" ToolTip="搜索桌面"/>
                        </Grid>
                        <ListBox Grid.Row="1" x:Name="SceneList" SelectionChanged="SceneList_SelectionChanged" Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListBox.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ListBox.ItemsPanel>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border Width="214" Height="146" Margin="0,0,12,12" CornerRadius="10" Background="White" BorderBrush="#D9DEE6" BorderThickness="1" Padding="12">
                                        <Grid>
                                            <Grid.RowDefinitions><RowDefinition Height="68"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                                            <Border CornerRadius="7" BorderBrush="#DCE5FF" BorderThickness="1" Background="{Binding Converter={StaticResource ScenePreviewBrush}}">
                                                <Grid>
                                                    <Ellipse Width="90" Height="90" Fill="#604F7CFF" Opacity="0.22" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-34,-22,0"><Ellipse.Effect><BlurEffect Radius="16"/></Ellipse.Effect></Ellipse>
                                                    <Ellipse Width="60" Height="60" Fill="#408796FF" Opacity="0.18" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="-18,-10,0,-18"><Ellipse.Effect><BlurEffect Radius="12"/></Ellipse.Effect></Ellipse>
                                                    <TextBlock Text="{Binding Kind}" Foreground="#9EB3D4" FontSize="10" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="9"/>
                                                </Grid>
                                            </Border>
                                            <StackPanel Grid.Row="1" Margin="1,8,1,0">
                                                <TextBlock Text="{Binding Title}" Foreground="#1F2328" FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Text="{Binding Description}" Foreground="#667085" FontSize="9.8" TextTrimming="CharacterEllipsis" Margin="0,4,0,0"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>

                    <Border Grid.Column="2" Background="White" BorderBrush="#D9DEE6" BorderThickness="1" CornerRadius="10" Padding="16">
                        <StackPanel>
                            <TextBlock x:Name="SelectedTitle" Text="选择一个桌面" Foreground="#1F2328" FontSize="17" FontWeight="SemiBold"/>
                            <TextBlock x:Name="SelectedMeta" Text="" Foreground="#667085" FontSize="10.5" Margin="0,5,0,0" TextWrapping="Wrap"/>
                            <TextBlock x:Name="SelectedDescription" Text="从左边选择一个桌面，然后直接应用。" Foreground="#475467" TextWrapping="Wrap" FontSize="11" Margin="0,14,0,18"/>
                            <Button x:Name="ApplySceneButton" Content="应用到桌面" Click="ApplyScene_Click" Height="38" Style="{StaticResource PrimaryButton}" IsEnabled="False"/>
                            <Button x:Name="ExportSceneButton" Content="导出 .tdscene" Click="ExportScene_Click" Height="34" Margin="0,8,0,0" IsEnabled="False"/>
                            <Separator Margin="0,18,0,15" Background="#D9DEE6"/>
                            <TextBlock Text="当前场景" Foreground="#667085" FontSize="10.5"/>
                            <TextBlock x:Name="CurrentSceneText" Text="-" Foreground="#1F2328" Margin="0,5,0,0" FontWeight="SemiBold"/>
                            <TextBlock Text="提示：视频和 Web 场景会在全屏游戏时按“性能”页的规则自动暂停或释放。" Foreground="#667085" FontSize="10" TextWrapping="Wrap" Margin="0,14,0,0"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </TabItem>

            <TabItem Header="播放列表">
                <Grid Margin="8,14">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="280"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="播放列表" FontSize="20" FontWeight="SemiBold" Foreground="#1F2328"/>
                        <TextBlock Text="按时间自动轮换桌面。" Foreground="#667085" FontSize="11" Margin="0,4,0,12"/>
                        <ListBox x:Name="PlaylistList" Height="350" Background="White" BorderBrush="#D9DEE6" BorderThickness="1" SelectionChanged="PlaylistList_SelectionChanged" DisplayMemberPath="Name"/>
                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0"><Button Content="新建" Click="NewPlaylist_Click" Padding="13,6"/><Button Content="删除" Click="DeletePlaylist_Click" Padding="13,6" Margin="8,0,0,0"/></StackPanel>
                    </StackPanel>
                    <Border Grid.Column="2" Background="White" BorderBrush="#D9DEE6" BorderThickness="1" CornerRadius="10" Padding="18">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <TextBlock Text="播放列表设置" Foreground="#1F2328" FontSize="17" FontWeight="SemiBold"/>
                                <TextBlock Text="名称" Foreground="#667085" FontSize="10.5" Margin="0,15,0,5"/><TextBox x:Name="PlaylistNameBox"/>
                                <TextBlock Text="场景 ID（每行一个，可从“已安装”页复制/选择）" Foreground="#667085" FontSize="10.5" Margin="0,12,0,5"/><TextBox x:Name="PlaylistScenesBox" Height="130" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" TextWrapping="NoWrap"/>
                                <TextBlock Text="轮换间隔（分钟）" Foreground="#667085" FontSize="10.5" Margin="0,12,0,5"/><TextBox x:Name="PlaylistIntervalBox" Text="10"/>
                                <CheckBox x:Name="PlaylistShuffleCheck" Content="随机顺序" Margin="0,12,0,0"/>
                                <CheckBox x:Name="PlaylistChangePausedCheck" Content="暂停时仍允许切换" Margin="0,7,0,0"/>
                                <StackPanel Orientation="Horizontal" Margin="0,18,0,0"><Button Content="保存" Click="SavePlaylist_Click" Padding="16,7"/><Button Content="立即使用" Click="ActivatePlaylist_Click" Padding="16,7" Margin="8,0,0,0" Style="{StaticResource PrimaryButton}"/></StackPanel>
                            </StackPanel>
                        </ScrollViewer>
                    </Border>
                </Grid>
            </TabItem>

            <TabItem Header="多屏配置">
                <Grid Margin="4,8"><local:MonitorProfilesControl x:Name="MonitorProfiles"/></Grid>
            </TabItem>

            <TabItem Header="应用规则">
                <Grid Margin="8,14">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="320"/></Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="应用规则" FontSize="20" FontWeight="SemiBold" Foreground="#1F2328"/>
                        <TextBlock Text="游戏、音乐、工作软件启动时自动暂停、停止或切换桌面。" Foreground="#667085" FontSize="11" Margin="0,4,0,12"/>
                        <DataGrid x:Name="RuleGrid" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True" Height="380">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="程序" Binding="{Binding ExeName}" Width="*"/>
                                <DataGridTextColumn Header="条件" Binding="{Binding Condition}" Width="100"/>
                                <DataGridTextColumn Header="动作" Binding="{Binding Action}" Width="110"/>
                                <DataGridTextColumn Header="目标" Binding="{Binding TargetId}" Width="140"/>
                            </DataGrid.Columns>
                        </DataGrid>
                        <Button Content="删除选中规则" Click="DeleteRule_Click" Padding="13,6" HorizontalAlignment="Left" Margin="0,10,0,0"/>
                    </StackPanel>
                    <Border Grid.Column="2" Background="White" BorderBrush="#D9DEE6" BorderThickness="1" CornerRadius="10" Padding="18">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <TextBlock Text="新规则" Foreground="#1F2328" FontSize="17" FontWeight="SemiBold"/>
                                <TextBlock Text="程序名，例如 dota2.exe" Foreground="#667085" FontSize="10.5" Margin="0,15,0,5"/><TextBox x:Name="RuleExeBox"/>
                                <TextBlock Text="条件" Foreground="#667085" FontSize="10.5" Margin="0,12,0,5"/><ComboBox x:Name="RuleConditionCombo"><ComboBoxItem Tag="Running" Content="程序运行时" IsSelected="True"/><ComboBoxItem Tag="Fullscreen" Content="该程序全屏时"/></ComboBox>
                                <TextBlock Text="动作" Foreground="#667085" FontSize="10.5" Margin="0,12,0,5"/><ComboBox x:Name="RuleActionCombo" SelectionChanged="RuleActionCombo_SelectionChanged"><ComboBoxItem Tag="KeepRunning" Content="保持运行"/><ComboBoxItem Tag="Pause" Content="暂停" IsSelected="True"/><ComboBoxItem Tag="Stop" Content="停止并释放"/><ComboBoxItem Tag="LoadScene" Content="加载场景"/><ComboBoxItem Tag="LoadPlaylist" Content="加载播放列表"/><ComboBoxItem Tag="LoadProfile" Content="加载多屏配置"/></ComboBox>
                                <TextBlock x:Name="RuleTargetLabel" Text="目标 ID" Foreground="#667085" FontSize="10.5" Margin="0,12,0,5" Visibility="Collapsed"/><TextBox x:Name="RuleTargetBox" Visibility="Collapsed"/>
                                <Button Content="添加规则" Click="AddRule_Click" Padding="15,8" Margin="0,18,0,0" Style="{StaticResource PrimaryButton}"/>
                            </StackPanel>
                        </ScrollViewer>
                    </Border>
                </Grid>
            </TabItem>

            <TabItem Header="性能">
                <Grid Margin="8,14" MaxWidth="700" HorizontalAlignment="Left">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <TextBlock Text="性能" FontSize="20" FontWeight="SemiBold" Foreground="#1F2328"/>
                            <TextBlock Text="遇到游戏或全屏程序时主动让出 GPU 和内存。" Foreground="#667085" FontSize="11" Margin="0,4,0,18"/>
                            <Border Background="White" BorderBrush="#D9DEE6" BorderThickness="1" CornerRadius="10" Padding="18">
                                <StackPanel>
                                    <TextBlock Text="其他程序全屏时" Foreground="#1F2328" FontWeight="SemiBold"/><ComboBox x:Name="FullscreenBehaviorCombo" Margin="0,7,0,15"><ComboBoxItem Tag="KeepRunning" Content="保持运行"/><ComboBoxItem Tag="Pause" Content="暂停（推荐）" IsSelected="True"/><ComboBoxItem Tag="Stop" Content="停止并释放内存"/></ComboBox>
                                    <TextBlock Text="其他程序最大化时" Foreground="#1F2328" FontWeight="SemiBold"/><ComboBox x:Name="MaximizedBehaviorCombo" Margin="0,7,0,15"><ComboBoxItem Tag="KeepRunning" Content="保持运行" IsSelected="True"/><ComboBoxItem Tag="Pause" Content="暂停"/><ComboBoxItem Tag="Stop" Content="停止并释放内存"/></ComboBox>
                                    <TextBlock Text="全局 FPS 上限" Foreground="#1F2328" FontWeight="SemiBold"/><Slider x:Name="FpsSlider" Minimum="15" Maximum="144" TickFrequency="15" IsSnapToTickEnabled="False" Margin="0,7,0,0"/><TextBlock x:Name="FpsText" Text="60 FPS" Foreground="#667085" Margin="0,3,0,14"/>
                                    <TextBlock Text="壁纸音量" Foreground="#1F2328" FontWeight="SemiBold"/><Slider x:Name="VolumeSlider" Minimum="0" Maximum="1" TickFrequency="0.1" Margin="0,7,0,0"/><TextBlock x:Name="VolumeText" Text="静音" Foreground="#667085" Margin="0,3,0,14"/>
                                    <Button Content="保存性能设置" Click="SavePerformance_Click" Padding="15,8" HorizontalAlignment="Left" Style="{StaticResource PrimaryButton}"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </TabItem>

            <TabItem Header="AI">
                <Grid Margin="8,14" MaxWidth="760" HorizontalAlignment="Left">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <TextBlock Text="AI" FontSize="20" FontWeight="SemiBold" Foreground="#1F2328"/>
                            <TextBlock Text="顶部搜索框和语音使用同一套模型与 Harness。" Foreground="#667085" FontSize="11" Margin="0,4,0,18"/>
                            <Border Background="White" BorderBrush="#D9DEE6" BorderThickness="1" CornerRadius="10" Padding="18">
                                <StackPanel>
                                    <TextBlock Text="当前模型" Foreground="#667085" FontSize="10.5"/>
                                    <TextBlock x:Name="AiModelText" Text="加载中…" Foreground="#1F2328" FontSize="15" FontWeight="SemiBold" Margin="0,4,0,14"/>
                                    <StackPanel Orientation="Horizontal">
                                        <Button Content="模型设置" Click="ModelSettings_Click" Padding="15,7"/>
                                        <Button Content="打开 Harness" Click="Harness_Click" Padding="15,7" Margin="8,0,0,0" Style="{StaticResource PrimaryButton}"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </TabItem>
            <TabItem Header="高级 / 诊断">
                <Grid Margin="8,14" MaxWidth="760" HorizontalAlignment="Left">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <TextBlock Text="高级 / 诊断" FontSize="20" FontWeight="SemiBold" Foreground="#1F2328"/>
                            <TextBlock Text="版本、构建信息和运行状态。" Foreground="#667085" FontSize="11" Margin="0,4,0,18"/>
                            <Border Background="White" BorderBrush="#D9DEE6" BorderThickness="1" CornerRadius="10" Padding="18">
                                <StackPanel>
                                    <TextBlock Text="版本信息" Foreground="#667085" FontSize="10.5"/>
                                    <TextBlock x:Name="VersionText" Text="加载中…" Foreground="#1F2328" FontSize="13" Margin="0,4,0,14"/>
                                    <TextBlock Text="Harness WebUI" Foreground="#667085" FontSize="10.5"/>
                                    <TextBlock x:Name="HarnessStatusText" Text="未启动（按需运行）" Foreground="#1F2328" FontSize="13" Margin="0,4,0,14"/>
                                    <TextBlock Text="WebView2" Foreground="#667085" FontSize="10.5"/>
                                    <TextBlock x:Name="WebViewStatusText" Text="加载中…" Foreground="#1F2328" FontSize="13" Margin="0,4,0,14"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</Window>
