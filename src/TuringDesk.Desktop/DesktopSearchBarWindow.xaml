<Window x:Class="TuringDesk.Desktop.DesktopSearchBarWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:TuringDesk.Desktop"
        Title="TuringDesk Search"
        Width="760" Height="78"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        ShowActivated="False"
        Topmost="False"
        FontFamily="Segoe UI Variable, Segoe UI">
    <Grid Margin="10">
        <Border x:Name="SearchShell"
                VerticalAlignment="Top"
                CornerRadius="22"
                Background="#F2181C25"
                BorderBrush="#66748FFF"
                BorderThickness="1"
                Padding="10,8">
            <Border.Effect>
                <DropShadowEffect BlurRadius="30" ShadowDepth="6" Opacity="0.42" Color="#000000"/>
            </Border.Effect>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="42"/>
                    <RowDefinition x:Name="ReplyRow" Height="0"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="38"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="38"/>
                        <ColumnDefinition Width="38"/>
                    </Grid.ColumnDefinitions>

                    <local:ShellIcon Grid.Column="0" Kind="Search" Width="19" Height="19" Foreground="#AEB9FF" HorizontalAlignment="Center" VerticalAlignment="Center"/>

                    <Grid Grid.Column="1" Margin="2,0,8,0">
                        <TextBox x:Name="SearchBox"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 Foreground="#F6F8FC"
                                 CaretBrush="#AEB9FF"
                                 FontSize="15.5"
                                 Padding="2,0"
                                 VerticalContentAlignment="Center"
                                 KeyDown="SearchBox_KeyDown"
                                 TextChanged="SearchBox_TextChanged"/>
                        <TextBlock x:Name="PlaceholderText"
                                   Text="搜索应用、文件，或直接问图灵…"
                                   Foreground="#7E899E"
                                   FontSize="14.5"
                                   VerticalAlignment="Center"
                                   IsHitTestVisible="False"/>
                    </Grid>

                    <Button Grid.Column="2" x:Name="MicButton" Width="34" Height="34" Padding="0" Click="Mic_Click" ToolTip="语音输入">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border CornerRadius="11" Background="#10151E" BorderBrush="#2E394C" BorderThickness="1">
                                    <local:ShellIcon Kind="Microphone" Width="16" Height="16" Foreground="#AAB5CA" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>

                    <Button Grid.Column="3" x:Name="SettingsButton" Width="34" Height="34" Padding="0" Margin="4,0,0,0" Click="Settings_Click" ToolTip="桌面设计与综合设置">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border CornerRadius="11" Background="#252D49" BorderBrush="#6474D8" BorderThickness="1">
                                    <local:ShellIcon Kind="Personalize" Width="17" Height="17" Foreground="#C5CCFF" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </Grid>

                <Border x:Name="ReplyPanel"
                        Grid.Row="1"
                        Visibility="Collapsed"
                        Margin="38,8,38,2"
                        Padding="12,10"
                        CornerRadius="13"
                        Background="#D90E121A"
                        BorderBrush="#2F394C"
                        BorderThickness="1">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <StackPanel Orientation="Horizontal">
                            <Ellipse x:Name="ReplyDot" Width="7" Height="7" Fill="#7F8FFF" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock x:Name="ReplyTitle" Text="图灵" Foreground="#AEB9CE" FontSize="10.5" FontWeight="SemiBold"/>
                        </StackPanel>
                        <TextBlock x:Name="ReplyText"
                                   Grid.Row="1"
                                   Margin="0,7,0,0"
                                   Foreground="#E9EDF6"
                                   FontSize="12.5"
                                   TextWrapping="Wrap"
                                   MaxHeight="116"/>
                    </Grid>
                </Border>
            </Grid>
        </Border>
    </Grid>
</Window>
