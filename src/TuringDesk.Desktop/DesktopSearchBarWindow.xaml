<Window x:Class="TuringDesk.Desktop.DesktopSearchBarWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:TuringDesk.Desktop"
        Title="TuringDesk Search"
        Width="980" Height="78"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        ShowActivated="False"
        Topmost="False"
        FontFamily="Segoe UI Variable, Segoe UI">
    <Grid Margin="8">
        <Border x:Name="SearchShell"
                VerticalAlignment="Top"
                CornerRadius="20"
                Background="#FAFFFFFF"
                BorderBrush="#CCD4E0"
                BorderThickness="1"
                Padding="8,7">
            <Border.Effect>
                <DropShadowEffect BlurRadius="24" ShadowDepth="5" Opacity="0.20" Color="#000000"/>
            </Border.Effect>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="46"/>
                    <RowDefinition x:Name="SearchResultsRow" Height="0"/>
                    <RowDefinition x:Name="ReplyRow" Height="0"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="228"/>
                        <ColumnDefinition Width="34"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="72"/>
                        <ColumnDefinition Width="72"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0"
                            Height="38"
                            Margin="0,4,8,4"
                            CornerRadius="11"
                            Background="#EEF4FF"
                            BorderBrush="#C8D8FF"
                            BorderThickness="1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="42"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0"
                                    Width="30" Height="26"
                                    Margin="6,0,4,0"
                                    CornerRadius="8"
                                    Background="#2563EB"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Center">
                                <TextBlock Text="AI"
                                           Foreground="White"
                                           FontSize="11"
                                           FontWeight="Bold"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel Grid.Column="1" Margin="3,3,6,2">
                                <TextBlock Text="L3 模型"
                                           Foreground="#64748B"
                                           FontSize="9.5"
                                           LineHeight="11"/>
                                <ComboBox x:Name="ModelSelector"
                                          Height="21"
                                          Padding="3,0"
                                          VerticalContentAlignment="Center"
                                          Foreground="#111827"
                                          Background="White"
                                          BorderBrush="#D5DEEC"
                                          BorderThickness="1"
                                          FontSize="11.5"
                                          FontWeight="SemiBold"
                                          DisplayMemberPath="DisplayName"
                                          ToolTip="L3 本地工具无需模型；问答、翻译和解释使用这里选择的模型。复杂 Agent 任务只有显式深度处理才启动 Harness"
                                          SelectionChanged="ModelSelector_SelectionChanged"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <local:ShellIcon Grid.Column="1"
                                     Kind="Search"
                                     Width="18" Height="18"
                                     Foreground="#475569"
                                     HorizontalAlignment="Center"
                                     VerticalAlignment="Center"/>

                    <Grid Grid.Column="2" Margin="4,0,10,0">
                        <TextBox x:Name="SearchBox"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 Foreground="#111827"
                                 CaretBrush="#2563EB"
                                 FontSize="15.5"
                                 Padding="2,0"
                                 VerticalContentAlignment="Center"
                                 KeyDown="SearchBox_KeyDown"
                                 TextChanged="SearchBox_TextChanged"/>
                        <TextBlock x:Name="PlaceholderText"
                                   Text="搜索应用/文件，问 AI，或输入 /help 使用本地 CLI…"
                                   Foreground="#7B8798"
                                   FontSize="14.5"
                                   VerticalAlignment="Center"
                                   IsHitTestVisible="False"/>
                    </Grid>

                    <Button Grid.Column="3"
                            x:Name="MicButton"
                            Height="34"
                            Margin="2,6,2,6"
                            Padding="0"
                            Click="Mic_Click"
                            ToolTip="语音输入">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border CornerRadius="10"
                                        Background="#F1F5F9"
                                        BorderBrush="#D7DEE8"
                                        BorderThickness="1">
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <local:ShellIcon Kind="Microphone" Width="14" Height="14" Foreground="#475569" Margin="0,0,5,0"/>
                                        <TextBlock Text="语音" Foreground="#334155" FontSize="11.5" FontWeight="SemiBold"/>
                                    </StackPanel>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>

                    <Button Grid.Column="4"
                            x:Name="SettingsButton"
                            Height="34"
                            Margin="2,6,0,6"
                            Padding="0"
                            Click="Settings_Click"
                            ToolTip="桌面与 AI 设置">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border CornerRadius="10"
                                        Background="#E8F0FF"
                                        BorderBrush="#BFD0FF"
                                        BorderThickness="1">
                                    <TextBlock Text="设置"
                                               Foreground="#1D4ED8"
                                               FontSize="11.5"
                                               FontWeight="SemiBold"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"/>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </Grid>

                <Border x:Name="SearchResultsPanel"
                        Grid.Row="1"
                        Visibility="Collapsed"
                        Margin="8,8,8,2"
                        Padding="6"
                        CornerRadius="13"
                        Background="#FCFFFFFF"
                        BorderBrush="#D8DEE8"
                        BorderThickness="1">
                    <ListBox x:Name="SearchResultsList"
                             Background="Transparent"
                             BorderThickness="0"
                             Foreground="#111827"
                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                             MouseLeftButtonUp="SearchResultsList_MouseLeftButtonUp">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Padding" Value="8,6"/>
                                <Setter Property="Margin" Value="0,1"/>
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="BorderThickness" Value="0"/>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="50"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid Grid.Column="0" Width="40" Height="32" HorizontalAlignment="Left" VerticalAlignment="Center">
                                        <Image Source="{Binding Icon}"
                                               Width="28" Height="28"
                                               HorizontalAlignment="Left"
                                               VerticalAlignment="Center"
                                               Stretch="Uniform"/>
                                        <Border Width="40" Height="24"
                                                HorizontalAlignment="Left"
                                                VerticalAlignment="Center"
                                                CornerRadius="7"
                                                Background="#E8F0FF"
                                                BorderBrush="#C8D8FF"
                                                BorderThickness="1">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Icon}" Value="{x:Null}">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock Text="{Binding KindLabel}"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"
                                                       Foreground="#1D4ED8"
                                                       FontSize="10.5"
                                                       FontWeight="SemiBold"/>
                                        </Border>
                                    </Grid>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="{Binding Name}"
                                                   Foreground="#111827"
                                                   FontSize="12.5"
                                                   FontWeight="SemiBold"
                                                   TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{Binding Subtitle}"
                                                   Margin="0,2,0,0"
                                                   Foreground="#64748B"
                                                   FontSize="10.5"
                                                   TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Border>

                <Border x:Name="ReplyPanel"
                        Grid.Row="2"
                        Visibility="Collapsed"
                        Margin="8,8,8,2"
                        Padding="12,10"
                        CornerRadius="13"
                        Background="#FCFFFFFF"
                        BorderBrush="#D8DEE8"
                        BorderThickness="1">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <StackPanel Orientation="Horizontal">
                            <Ellipse x:Name="ReplyDot" Width="7" Height="7" Fill="#2563EB" Margin="0,0,8,0" VerticalAlignment="Center"/>
                            <TextBlock x:Name="ReplyTitle" Text="图灵" Foreground="#475569" FontSize="10.5" FontWeight="SemiBold"/>
                        </StackPanel>
                        <TextBlock x:Name="ReplyText"
                                   Grid.Row="1"
                                   Margin="0,7,0,0"
                                   Foreground="#111827"
                                   FontSize="12.5"
                                   TextWrapping="Wrap"
                                   MaxHeight="116"/>
                        <Button x:Name="DeepProcessButton"
                                Grid.Row="2"
                                Visibility="Collapsed"
                                HorizontalAlignment="Left"
                                Margin="0,10,0,0"
                                Padding="13,6"
                                Click="DeepProcess_Click"
                                Background="#2563EB"
                                Foreground="White"
                                BorderBrush="#1D4ED8"
                                BorderThickness="1"
                                FontSize="11.5"
                                FontWeight="SemiBold"
                                Content="深度处理 · 打开 AI 工作台"/>
                    </Grid>
                </Border>
            </Grid>
        </Border>
    </Grid>
</Window>