<Window x:Class="TuringDesk.Desktop.HarnessConsoleWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="TuringDesk · DeepSeek Harness"
        Width="980" Height="660"
        MinWidth="760" MinHeight="520"
        WindowStartupLocation="CenterOwner"
        WindowStyle="SingleBorderWindow"
        ResizeMode="CanResize"
        Background="#F5F6F8"
        Foreground="#1F2328"
        FontFamily="Segoe UI Variable, Segoe UI">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Foreground" Value="#1F2328"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#C9D0DA"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="MinHeight" Value="32"/>
        </Style>
    </Window.Resources>
    <Grid Background="#F5F6F8">
        <Grid.RowDefinitions>
            <RowDefinition Height="46"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="White" BorderBrush="#D9DEE6" BorderThickness="0,0,0,1" Padding="14,7">
            <DockPanel LastChildFill="True">
                <Button DockPanel.Dock="Right" Content="刷新" Click="Refresh_Click" Width="72"/>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="DeepSeek Harness" Foreground="#1F2328" FontSize="14" FontWeight="SemiBold"/>
                    <TextBlock Text="高级 Agent 控制台" Foreground="#667085" FontSize="10" Margin="0,1,0,0"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <Grid Grid.Row="1" Background="White">
            <wv2:WebView2 x:Name="HarnessView" Visibility="Collapsed"/>

            <Grid x:Name="LoadingPanel" Background="White">
                <StackPanel Width="420" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock x:Name="LoadingTitle" Text="正在启动 Agent 控制台" Foreground="#1F2328" FontSize="20" FontWeight="SemiBold" TextAlignment="Center"/>
                    <TextBlock x:Name="LoadingDetail"
                               Text="正在启动本机 DeepSeek Harness WebUI…"
                               Foreground="#667085"
                               TextAlignment="Center"
                               TextWrapping="Wrap"
                               Margin="0,8,0,18"/>
                    <ProgressBar x:Name="LoadingProgress" Height="4" IsIndeterminate="True"/>
                    <Button x:Name="RetryButton" Content="重试" Width="96" HorizontalAlignment="Center" Margin="0,18,0,0" Visibility="Collapsed" Click="Retry_Click"/>
                </StackPanel>
            </Grid>
        </Grid>
    </Grid>
</Window>
