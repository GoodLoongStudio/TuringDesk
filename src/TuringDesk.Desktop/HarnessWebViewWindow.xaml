<Window x:Class="TuringDesk.Desktop.HarnessWebViewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:TuringDesk.Desktop"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="TuringDesk · DeepSeek Harness"
        Width="1240" Height="840"
        MinWidth="900" MinHeight="620"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        ResizeMode="CanResize"
        Background="#0B0D12"
        Foreground="{StaticResource TextBrush}"
        FontFamily="Segoe UI Variable, Segoe UI">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="52"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Background="#10131A"
                BorderBrush="#293142"
                BorderThickness="0,0,0,1"
                MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
            <Grid Margin="14,0,8,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="30" Height="30"
                            CornerRadius="9"
                            Background="{StaticResource AccentSoftBrush}"
                            Margin="0,0,10,0">
                        <local:ShellIcon Kind="Agent"
                                         Width="17" Height="17"
                                         Foreground="{StaticResource AccentBrush}"
                                         HorizontalAlignment="Center"
                                         VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="DeepSeek Harness"
                                   FontSize="14" FontWeight="SemiBold"/>
                        <TextBlock x:Name="StatusText"
                                   Text="正在准备官方界面…"
                                   Foreground="{StaticResource MutedBrush}"
                                   FontSize="10"/>
                    </StackPanel>
                    <Border Margin="12,0,0,0"
                            Padding="8,3"
                            CornerRadius="10"
                            Background="#172238">
                        <TextBlock Text="TuringDesk"
                                   Foreground="{StaticResource AccentBrush}"
                                   FontSize="9.5"
                                   FontWeight="SemiBold"/>
                    </Border>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Width="38" Height="34" Padding="0" Click="Reload_Click" ToolTip="刷新">
                        <local:ShellIcon Kind="Refresh" Width="14" Height="14" Foreground="#B7C0D2"/>
                    </Button>
                    <Button Width="38" Height="34" Padding="0" Click="Minimize_Click" ToolTip="最小化">
                        <local:ShellIcon Kind="Minimize" Width="14" Height="14" Foreground="#B7C0D2"/>
                    </Button>
                    <Button Width="38" Height="34" Padding="0" Click="Maximize_Click" ToolTip="最大化/还原">
                        <local:ShellIcon x:Name="MaximizeIcon" Kind="Maximize" Width="14" Height="14" Foreground="#B7C0D2"/>
                    </Button>
                    <Button Width="42" Height="34" Padding="0" Click="Close_Click" ToolTip="关闭">
                        <local:ShellIcon Kind="Close" Width="14" Height="14" Foreground="#D3D8E3"/>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="1"
                Background="#0B0D12"
                BorderBrush="#202737"
                BorderThickness="1,0,1,1">
            <Grid>
                <wv2:WebView2 x:Name="HarnessWebView"
                              Visibility="Hidden"
                              DefaultBackgroundColor="#0B0D12"
                              NavigationCompleted="HarnessWebView_NavigationCompleted"/>

                <Grid x:Name="LoadingPanel" Background="#0B0D12">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Width="420">
                        <Border Width="54" Height="54"
                                CornerRadius="17"
                                Background="{StaticResource AccentSoftBrush}"
                                HorizontalAlignment="Center">
                            <local:ShellIcon Kind="Agent"
                                             Width="28" Height="28"
                                             Foreground="{StaticResource AccentBrush}"
                                             HorizontalAlignment="Center"
                                             VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="正在启动 DeepSeek Harness"
                                   HorizontalAlignment="Center"
                                   FontSize="18"
                                   FontWeight="SemiBold"
                                   Margin="0,18,0,0"/>
                        <TextBlock x:Name="LoadingText"
                                   Text="TuringDesk 正在加载官方 WebUI，不会打开浏览器窗口。"
                                   HorizontalAlignment="Center"
                                   TextAlignment="Center"
                                   TextWrapping="Wrap"
                                   Foreground="{StaticResource MutedBrush}"
                                   FontSize="11.5"
                                   Margin="0,8,0,0"/>
                        <ProgressBar Height="3"
                                     IsIndeterminate="True"
                                     Margin="28,24,28,0"/>
                        <Button x:Name="RetryButton"
                                Content="重试"
                                Width="88"
                                Margin="0,18,0,0"
                                HorizontalAlignment="Center"
                                Visibility="Collapsed"
                                Click="Retry_Click"/>
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
