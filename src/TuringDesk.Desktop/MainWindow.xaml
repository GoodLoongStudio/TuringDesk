<Window x:Class="TuringDesk.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="TuringDesk"
        MinWidth="1100" MinHeight="720"
        WindowState="Maximized"
        Background="#0B0E14"
        Foreground="{StaticResource TextBrush}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="54"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="82"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#10141C" BorderBrush="#232A38" BorderThickness="0,0,0,1">
            <Grid Margin="18,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="TuringDesk" FontSize="18" FontWeight="SemiBold"/>
                    <TextBlock Text="  图灵桌面" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse x:Name="RuntimeDot" Width="8" Height="8" Fill="#F2A65A" Margin="0,0,8,0"/>
                    <TextBlock x:Name="RuntimeStatus" Text="Runtime connecting…" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center"/>
                    <Border Width="1" Height="22" Background="#30394B" Margin="14,0"/>
                    <Button x:Name="SpeechButton" Content="🎙 Voice starting…" Click="SpeechToggle_Click" Padding="10,5" Margin="0,0,8,0"/>
                    <TextBlock x:Name="ModelStatus" Text="Model: Mock" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <Button Content="⚙ 模型" Click="ModelSettings_Click" Padding="10,5"/>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1" Margin="14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="210"/>
                <ColumnDefinition Width="14"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="14"/>
                <ColumnDefinition Width="320"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="{StaticResource SurfaceBrush}" CornerRadius="14" Padding="14">
                <StackPanel>
                    <TextBlock Text="Workspace" FontWeight="SemiBold" Margin="4,2,0,14"/>
                    <Button Content="✦  AI Home" HorizontalContentAlignment="Left"/>
                    <Button Content="▣  Apps" HorizontalContentAlignment="Left"/>
                    <Button Content="☰  Files" HorizontalContentAlignment="Left"/>
                    <Button Content="✓  Tasks" HorizontalContentAlignment="Left"/>
                    <Button Content="◌  Memory" HorizontalContentAlignment="Left"/>

                    <Border Height="1" Background="#2A3140" Margin="0,18,0,14"/>
                    <TextBlock Text="Quick launch" Foreground="{StaticResource MutedBrush}" Margin="4,0,0,8"/>
                    <Button Content="Chrome" Click="Chrome_Click" HorizontalContentAlignment="Left"/>
                    <Button Content="VS Code" Click="VSCode_Click" HorizontalContentAlignment="Left"/>
                    <Button Content="Terminal" Click="Terminal_Click" HorizontalContentAlignment="Left"/>
                </StackPanel>
            </Border>

            <Border Grid.Column="2" Background="{StaticResource SurfaceBrush}" CornerRadius="14" Padding="24">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <StackPanel>
                        <TextBlock Text="AI Workspace" FontSize="24" FontWeight="SemiBold"/>
                        <TextBlock Text="Apps remain native Windows windows; TuringDesk manages intent, layout and context."
                                   Foreground="{StaticResource MutedBrush}" Margin="0,7,0,20"/>
                    </StackPanel>
                    <Border Grid.Row="1" Background="#10151E" CornerRadius="12" Padding="22">
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="680">
                            <TextBlock Text="✦" FontSize="42" HorizontalAlignment="Center" Foreground="{StaticResource AccentBrush}"/>
                            <TextBlock Text="What do you want to do?" FontSize="26" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,14,0,10"/>
                            <TextBlock Text="键盘：打开 Chrome 和 VS Code，左右排列"
                                       Foreground="{StaticResource MutedBrush}" FontSize="15" TextAlignment="Center"/>
                            <TextBlock Text="语音：说“图灵桌面”，再说命令；也可以一句话说“图灵桌面，打开 Chrome”"
                                       Foreground="{StaticResource MutedBrush}" FontSize="14" TextAlignment="Center" Margin="0,7,0,0"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <Border Grid.Column="4" Background="{StaticResource SurfaceBrush}" CornerRadius="14" Padding="16">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="Activity" FontWeight="SemiBold" Margin="4,2,0,12"/>
                    <ListBox x:Name="ActivityList" Grid.Row="1" Background="Transparent" BorderThickness="0" Foreground="{StaticResource TextBrush}"/>
                </Grid>
            </Border>
        </Grid>

        <Border Grid.Row="2" Background="#10141C" BorderBrush="#232A38" BorderThickness="0,1,0,0" Padding="18,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="52"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="110"/>
                </Grid.ColumnDefinitions>
                <TextBox x:Name="CommandBox"
                         FontSize="16"
                         Padding="16,12"
                         Background="#1A202C"
                         Foreground="{StaticResource TextBrush}"
                         BorderBrush="#30394B"
                         BorderThickness="1"
                         KeyDown="CommandBox_KeyDown"
                         ToolTip="Ask TuringDesk anything"/>
                <Button Grid.Column="2" x:Name="MicButton" Content="🎙" Click="SpeechToggle_Click" ToolTip="暂停/恢复常驻语音"/>
                <Button Grid.Column="4" Content="Ask  ✦" Click="Ask_Click" Background="#334A8A"/>
            </Grid>
        </Border>
    </Grid>
</Window>
