<Window x:Class="TuringDesk.Desktop.ModelSettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="模型设置"
        Width="620" Height="610"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#0B0E14"
        Foreground="{StaticResource TextBrush}">
    <Grid Margin="26">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,18">
            <TextBlock Text="AI 模型" FontSize="25" FontWeight="SemiBold"/>
            <TextBlock Text="选提供商 → 粘贴 API Key → 保存。Key 存在 Windows Credential Manager，不写进配置文件。"
                       Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" Margin="0,7,0,0"/>
        </StackPanel>

        <StackPanel Grid.Row="1" Margin="0,0,0,14">
            <TextBlock Text="提供商" Margin="0,0,0,6"/>
            <ComboBox x:Name="ProviderBox" Height="38" SelectionChanged="ProviderBox_SelectionChanged"
                      DisplayMemberPath="Name"/>
            <TextBlock x:Name="ProviderHint" Foreground="{StaticResource MutedBrush}" Margin="0,6,0,0" TextWrapping="Wrap"/>
        </StackPanel>

        <StackPanel Grid.Row="2" Margin="0,0,0,14">
            <TextBlock Text="Base URL" Margin="0,0,0,6"/>
            <TextBox x:Name="BaseUrlBox" Height="38" Padding="10,7" Background="#1A202C" Foreground="{StaticResource TextBrush}"/>
        </StackPanel>

        <StackPanel Grid.Row="3" Margin="0,0,0,14">
            <TextBlock Text="模型 ID" Margin="0,0,0,6"/>
            <TextBox x:Name="ModelBox" Height="38" Padding="10,7" Background="#1A202C" Foreground="{StaticResource TextBrush}"
                     ToolTip="例如本地模型名、DeepSeek 模型 ID 或中转站提供的模型 ID"/>
        </StackPanel>

        <StackPanel Grid.Row="4" Margin="0,0,0,14">
            <TextBlock Text="API Key" Margin="0,0,0,6"/>
            <PasswordBox x:Name="ApiKeyBox" Height="38" Padding="10,7" Background="#1A202C" Foreground="{StaticResource TextBrush}"/>
            <TextBlock Text="本地模型通常可以留空。" Foreground="{StaticResource MutedBrush}" Margin="0,5,0,0"/>
        </StackPanel>

        <Border Grid.Row="5" Background="#10151E" CornerRadius="10" Padding="12" Margin="0,2,0,12">
            <TextBlock x:Name="StatusText" Text="配置只会发给本机 127.0.0.1 的 TuringDesk Runtime。"
                       Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap"/>
        </Border>

        <StackPanel Grid.Row="7" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="测试连接" Width="110" Click="Test_Click" Margin="0,0,10,0"/>
            <Button Content="取消" Width="90" IsCancel="True" Margin="0,0,10,0"/>
            <Button Content="保存并应用" Width="120" Click="Save_Click" Background="#334A8A"/>
        </StackPanel>
    </Grid>
</Window>
