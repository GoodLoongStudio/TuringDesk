<UserControl x:Class="TuringDesk.Desktop.MonitorProfilesControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#0A0D13"
             Foreground="#EEF2F8"
             FontFamily="Segoe UI Variable, Segoe UI">
    <Grid Margin="12,16">
        <Grid.ColumnDefinitions><ColumnDefinition Width="300"/><ColumnDefinition Width="18"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <StackPanel>
            <TextBlock Text="多显示器配置" FontSize="21" FontWeight="SemiBold"/>
            <TextBlock Text="每块屏幕独立选择桌面或播放列表。" Foreground="#8F9BAF" FontSize="11" Margin="0,4,0,12"/>
            <ListBox x:Name="ProfileList" Height="430" DisplayMemberPath="Name" SelectionChanged="ProfileList_SelectionChanged"/>
            <StackPanel Orientation="Horizontal" Margin="0,10,0,0"><Button Content="新建配置" Click="NewProfile_Click" Padding="13,6"/><Button Content="删除" Click="DeleteProfile_Click" Padding="13,6" Margin="8,0,0,0"/></StackPanel>
        </StackPanel>

        <Border Grid.Column="2" Background="#111720" BorderBrush="#2D374A" BorderThickness="1" CornerRadius="15" Padding="18">
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <TextBlock Text="配置内容" FontSize="17" FontWeight="SemiBold"/>
                <Grid Grid.Row="1" Margin="0,14,0,14"><Grid.ColumnDefinitions><ColumnDefinition Width="80"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><TextBlock Text="名称" Foreground="#8D99AE" VerticalAlignment="Center"/><TextBox Grid.Column="1" x:Name="ProfileNameBox"/></Grid>
                <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto"><StackPanel x:Name="AssignmentPanel"/></ScrollViewer>
                <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,14,0,0"><Button Content="保存配置" Click="SaveProfile_Click" Padding="16,7"/><Button Content="立即应用到所有屏幕" Click="ActivateProfile_Click" Padding="16,7" Margin="8,0,0,0" Background="#6575EE" BorderBrush="#7D8AFF" Foreground="White"/></StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
