<Window x:Class="TuringDesk.Desktop.NotificationCenterWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="TuringDesk Notifications"
        Width="420" Height="520"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        Background="#11141B"
        Foreground="{StaticResource TextBrush}"
        FontFamily="Segoe UI Variable, Segoe UI"
        KeyDown="Window_KeyDown">
    <Border Background="#11141B" BorderBrush="#35405B" BorderThickness="1" CornerRadius="16" Padding="16">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="0,0,0,12">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="通知中心" FontSize="20" FontWeight="SemiBold"/>
                    <TextBlock Text="TuringDesk、Agent 与 Shell 活动" Foreground="#8F9AB0" FontSize="10.5" Margin="0,3,0,0"/>
                </StackPanel>
                <Button Grid.Column="1" Content="✕" Width="36" Height="36" Padding="0" Click="Close_Click"/>
            </Grid>

            <ListBox Grid.Row="1" ItemsSource="{Binding Notifications}" Background="Transparent" BorderThickness="0" ScrollViewer.VerticalScrollBarVisibility="Auto">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                        <Setter Property="Margin" Value="0,0,0,7"/>
                        <Setter Property="Padding" Value="0"/>
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="BorderThickness" Value="0"/>
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Border Background="#1A1F2B" BorderBrush="#30394F" BorderThickness="1" CornerRadius="11" Padding="12">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="30"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <TextBlock Text="●" Foreground="#8E9CFF" VerticalAlignment="Top" Margin="2,2,0,0"/>
                                <StackPanel Grid.Column="1">
                                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="12"/>
                                        <TextBlock Grid.Column="1" Text="{Binding TimeText}" Foreground="#77849B" FontSize="9.5" Margin="10,0,0,0"/>
                                    </Grid>
                                    <TextBlock Text="{Binding Message}" Foreground="#A3AEC1" TextWrapping="Wrap" FontSize="10.5" Margin="0,5,0,0"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <Grid Grid.Row="2" Margin="0,10,0,0">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <TextBlock x:Name="CountText" Text="0 条通知" Foreground="#7F8AA0" FontSize="10" VerticalAlignment="Center"/>
                <Button Grid.Column="1" Content="清除全部" Height="34" Padding="12,0" Click="Clear_Click"/>
            </Grid>
        </Grid>
    </Border>
</Window>
