<UserControl x:Class="TuringDesk.Desktop.SceneRendererControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:TuringDesk.Desktop"
             xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
             Background="#080A10"
             Loaded="Renderer_Loaded"
             Unloaded="Renderer_Unloaded">
    <Grid x:Name="Root" ClipToBounds="True" IsHitTestVisible="False">
        <Border x:Name="StaticBackground" Background="#080A10"/>

        <!-- Actual D3D11 surface. WPF graph remains above it as a compatibility
             layer while image/effect/particle passes are migrated to shaders. -->
        <local:GpuSceneSurface x:Name="GpuSurface" Visibility="Collapsed"/>

        <Grid x:Name="BuiltInScene" Visibility="Collapsed">
            <Grid x:Name="AuroraLayer">
                <Ellipse x:Name="GlowA" Width="900" Height="900" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-340,-220,0" Opacity="0.55">
                    <Ellipse.Fill><RadialGradientBrush><GradientStop x:Name="GlowAColor" Color="#8A6477FF" Offset="0"/><GradientStop Color="#004653A0" Offset="1"/></RadialGradientBrush></Ellipse.Fill>
                    <Ellipse.Effect><BlurEffect Radius="80"/></Ellipse.Effect>
                </Ellipse>
                <Ellipse x:Name="GlowB" Width="780" Height="780" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="-260,0,0,-330" Opacity="0.42">
                    <Ellipse.Fill><RadialGradientBrush><GradientStop x:Name="GlowBColor" Color="#7354D9C4" Offset="0"/><GradientStop Color="#00305F60" Offset="1"/></RadialGradientBrush></Ellipse.Fill>
                    <Ellipse.Effect><BlurEffect Radius="86"/></Ellipse.Effect>
                </Ellipse>
                <Canvas x:Name="ParticleCanvas" Opacity="0.62"/>
                <Grid x:Name="GridLayer" Visibility="Collapsed" Opacity="0.25">
                    <Grid.Background>
                        <DrawingBrush TileMode="Tile" Viewport="0,0,64,64" ViewportUnits="Absolute">
                            <DrawingBrush.Drawing>
                                <GeometryDrawing Brush="Transparent">
                                    <GeometryDrawing.Pen><Pen Brush="#8B8FFF" Thickness="0.7"/></GeometryDrawing.Pen>
                                    <GeometryDrawing.Geometry><GeometryGroup><LineGeometry StartPoint="0,0" EndPoint="64,0"/><LineGeometry StartPoint="0,0" EndPoint="0,64"/></GeometryGroup></GeometryDrawing.Geometry>
                                </GeometryDrawing>
                            </DrawingBrush.Drawing>
                        </DrawingBrush>
                    </Grid.Background>
                </Grid>
            </Grid>
        </Grid>

        <Canvas x:Name="SceneGraphCanvas" Visibility="Collapsed" ClipToBounds="True"/>

        <MediaElement x:Name="VideoPlayer"
                      Visibility="Collapsed"
                      LoadedBehavior="Manual"
                      UnloadedBehavior="Manual"
                      Stretch="UniformToFill"
                      ScrubbingEnabled="False"
                      MediaEnded="VideoPlayer_MediaEnded"
                      MediaFailed="VideoPlayer_MediaFailed"/>

        <wv2:WebView2 x:Name="WebPlayer" Visibility="Collapsed"/>
    </Grid>
</UserControl>
