<Window x:Class="TuringDesk.Desktop.SessionMenuWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="TuringDesk Session"
        Width="330" Height="390"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        Background="#11141B"
        Foreground="{StaticResource TextBrush}"
        FontFamily="Segoe UI Variable, Segoe UI"
        KeyDown="Window_KeyDown">
    <Border Background="#11141B" BorderBrush="#35405B" BorderThickness="1" CornerRadius="16" Padding="18">
        <Grid>
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <StackPanel Margin="0,0,0,16">
                <TextBlock Text="会话与电源" FontSize="21" FontWeight="SemiBold"/>
                <TextBlock Text="这些操作只由用户点击触发，不开放给 Agent。" Foreground="#8F9AB0" FontSize="10.5" Margin="0,4,0,0"/>
            </StackPanel>

            <StackPanel Grid.Row="1">
                <Button Height="44" Margin="0,0,0,7" Click="Lock_Click" Content="🔒  锁定电脑" HorizontalContentAlignment="Left" Padding="14,0"/>
                <Button Height="44" Margin="0,0,0,7" Click="SignOut_Click" Content="⇥  注销当前用户" HorizontalContentAlignment="Left" Padding="14,0"/>
                <Button Height="44" Margin="0,0,0,7" Click="Restart_Click" Content="↻  重新启动 Windows" HorizontalContentAlignment="Left" Padding="14,0"/>
                <Button Height="44" Margin="0,0,0,7" Click="Shutdown_Click" Content="⏻  关闭 Windows" HorizontalContentAlignment="Left" Padding="14,0"/>
                <Separator Margin="0,6"/>
                <Button Height="44" Click="RestoreExplorer_Click" Content="↩  恢复 Explorer 桌面" HorizontalContentAlignment="Left" Padding="14,0"/>
            </StackPanel>

            <TextBlock Grid.Row="2" Text="Esc 关闭" Foreground="#7F8AA0" FontSize="10" Margin="2,12,0,0"/>
        </Grid>
    </Border>
</Window>
