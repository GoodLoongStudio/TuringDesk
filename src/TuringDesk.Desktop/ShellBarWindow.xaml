<Window x:Class="TuringDesk.Desktop.ShellBarWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="TuringDesk Shell Bar"
        Height="60"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        Background="#101319"
        Foreground="{StaticResource TextBrush}"
        FontFamily="Segoe UI Variable, Segoe UI">
    <Border Background="#101319" BorderBrush="#30394F" BorderThickness="0,1,0,0">
        <Grid Margin="8,7">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="48"/>
                <ColumnDefinition Width="46"/>
                <ColumnDefinition Width="46"/>
                <ColumnDefinition Width="42"/>
                <ColumnDefinition Width="42"/>
                <ColumnDefinition Width="42"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="310"/>
                <ColumnDefinition Width="82"/>
                <ColumnDefinition Width="46"/>
            </Grid.ColumnDefinitions>

            <Button Grid.Column="0" Width="42" Height="42" Padding="0" Click="Start_Click" ToolTip="开始">
                <TextBlock Text="▦" FontSize="19" Foreground="#A5B0FF"/>
            </Button>

            <Button Grid.Column="1" Width="40" Height="42" Padding="0" Click="Desktop_Click" ToolTip="显示桌面">
                <TextBlock Text="▱" FontSize="18" Foreground="#AAB4C8"/>
            </Button>

            <Button Grid.Column="2" Width="40" Height="42" Padding="0" Click="Home_Click" ToolTip="TuringDesk 控制中心">
                <TextBlock Text="✦" FontSize="18" Foreground="#9DAAFF"/>
            </Button>

            <Button Grid.Column="3" Width="38" Height="42" Padding="0" Click="Chrome_Click" ToolTip="Chrome">
                <TextBlock Text="◉" FontSize="17" Foreground="#AAB4C8"/>
            </Button>

            <Button Grid.Column="4" Width="38" Height="42" Padding="0" Click="VSCode_Click" ToolTip="VS Code">
                <TextBlock Text="⌘" FontSize="17" Foreground="#AAB4C8"/>
            </Button>

            <Button Grid.Column="5" Width="38" Height="42" Padding="0" Click="Terminal_Click" ToolTip="Terminal">
                <TextBlock Text=">_" FontSize="13" Foreground="#AAB4C8"/>
            </Button>

            <ScrollViewer Grid.Column="6" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled" Margin="6,0,8,0">
                <ItemsControl ItemsSource="{Binding Tasks}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Tag="{Binding Handle}"
                                    Click="Task_Click"
                                    Height="42"
                                    MinWidth="84"
                                    MaxWidth="168"
                                    Margin="0,0,5,0"
                                    Padding="10,0"
                                    ToolTip="{Binding Title}">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="3"/>
                                    </Grid.RowDefinitions>
                                    <TextBlock Text="{Binding ShortTitle}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" FontSize="11.5"/>
                                    <Border Grid.Row="1" Height="2" CornerRadius="1" Background="#8190FF" Opacity="{Binding ActiveOpacity}" Margin="6,0"/>
                                </Grid>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <Border Grid.Column="7" Height="42" Background="#1B202B" BorderBrush="#35405B" BorderThickness="1" CornerRadius="9" Margin="0,0,8,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="32"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="40"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="✦" Foreground="#9DAAFF" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    <TextBox Grid.Column="1"
                             x:Name="AgentBox"
                             BorderThickness="0"
                             Background="Transparent"
                             Padding="3,8"
                             VerticalContentAlignment="Center"
                             KeyDown="AgentBox_KeyDown"
                             ToolTip="直接告诉图灵你想做什么"/>
                    <Button Grid.Column="2" Content="→" Margin="4" Padding="0" Click="AgentSend_Click"/>
                </Grid>
            </Border>

            <StackPanel Grid.Column="8" VerticalAlignment="Center" Margin="0,0,7,0">
                <TextBlock x:Name="ClockText" Text="--:--" FontWeight="SemiBold" HorizontalAlignment="Right" FontSize="11.5"/>
                <TextBlock x:Name="DateText" Text="----/--/--" FontSize="9" Foreground="#8A95AA" HorizontalAlignment="Right"/>
            </StackPanel>

            <Button Grid.Column="9" Width="40" Height="42" Padding="0" Click="RestoreExplorer_Click" ToolTip="退出 TuringDesk Shell 并恢复 Explorer">
                <TextBlock Text="↩" FontSize="17" Foreground="#D6A76F"/>
            </Button>
        </Grid>
    </Border>
</Window>
