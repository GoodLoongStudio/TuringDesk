<Window x:Class="TuringDesk.Desktop.ShellBarWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="TuringDesk Shell Bar"
        Height="58"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        Background="#121419"
        Foreground="{StaticResource TextBrush}"
        FontFamily="Segoe UI Variable, Segoe UI">
    <Border Background="#121419" BorderBrush="{StaticResource StrokeBrush}" BorderThickness="0,1,0,0">
        <Grid Margin="10,7">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="390"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Button Grid.Column="0" Width="42" Height="42" Padding="0" Margin="0,0,6,0" Click="Home_Click" ToolTip="TuringDesk 首页">
                <TextBlock Text="✦" FontSize="18" Foreground="{StaticResource AccentBrush}"/>
            </Button>

            <Button Grid.Column="1" Height="42" Padding="13,0" Margin="0,0,8,0" Click="Apps_Click" Content="▦  应用"/>

            <ScrollViewer Grid.Column="2" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled" Margin="0,0,10,0">
                <ItemsControl ItemsSource="{Binding Tasks}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Tag="{Binding Handle}"
                                    Click="Task_Click"
                                    Height="42"
                                    MinWidth="90"
                                    MaxWidth="170"
                                    Margin="0,0,6,0"
                                    Padding="11,0"
                                    ToolTip="{Binding Title}">
                                <TextBlock Text="{Binding ShortTitle}" TextTrimming="CharacterEllipsis"/>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <Border Grid.Column="3" Height="42" Background="{StaticResource Surface2Brush}" BorderBrush="{StaticResource StrokeBrush}" BorderThickness="1" CornerRadius="9" Margin="0,0,10,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="34"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="42"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="✦" Foreground="{StaticResource AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    <TextBox Grid.Column="1"
                             x:Name="AgentBox"
                             BorderThickness="0"
                             Background="Transparent"
                             Padding="3,8"
                             VerticalContentAlignment="Center"
                             KeyDown="AgentBox_KeyDown"
                             ToolTip="直接告诉图灵你想做什么"/>
                    <Button Grid.Column="2" Content="→" Margin="4" Padding="0" Click="AgentSend_Click"/>
                </Grid>
            </Border>

            <StackPanel Grid.Column="4" VerticalAlignment="Center" Margin="0,0,10,0">
                <TextBlock x:Name="ClockText" Text="--:--" FontWeight="SemiBold" HorizontalAlignment="Right"/>
                <TextBlock x:Name="DateText" Text="----/--/--" FontSize="10" Foreground="{StaticResource MutedBrush}" HorizontalAlignment="Right"/>
            </StackPanel>

            <Button Grid.Column="5" Height="42" Padding="12,0" Click="RestoreExplorer_Click" ToolTip="退出 TuringDesk Shell 并恢复 Explorer">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="↩" FontSize="15" Margin="0,0,6,0"/>
                    <TextBlock Text="Explorer"/>
                </StackPanel>
            </Button>
        </Grid>
    </Border>
</Window>
