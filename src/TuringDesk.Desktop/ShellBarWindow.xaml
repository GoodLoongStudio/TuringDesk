<Window x:Class="TuringDesk.Desktop.ShellBarWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:TuringDesk.Desktop"
        Title="TuringDesk Shell Bar"
        Height="60"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        Background="#101319"
        Foreground="{StaticResource TextBrush}"
        FontFamily="Segoe UI Variable, Segoe UI">
    <Border x:Name="ShellBarRoot" Background="#101319" BorderBrush="#30394F" BorderThickness="0,1,0,0">
        <Grid Margin="8,7">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="48"/>
                <ColumnDefinition Width="46"/>
                <ColumnDefinition Width="46"/>
                <ColumnDefinition Width="46"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="310"/>
                <ColumnDefinition Width="126"/>
                <ColumnDefinition Width="42"/>
                <ColumnDefinition Width="42"/>
                <ColumnDefinition Width="82"/>
                <ColumnDefinition Width="46"/>
            </Grid.ColumnDefinitions>

            <Button Grid.Column="0" Width="42" Height="42" Padding="0" Click="Start_Click" ToolTip="开始 · Ctrl+Esc"><local:ShellIcon Kind="Start" Width="19" Height="19" Foreground="#A5B0FF"/></Button>
            <Button Grid.Column="1" Width="40" Height="42" Padding="0" Click="Desktop_Click" ToolTip="显示桌面 · Win+D"><local:ShellIcon Kind="Desktop" Width="19" Height="19" Foreground="#AAB4C8"/></Button>
            <Button Grid.Column="2" Width="40" Height="42" Padding="0" Click="Home_Click" ToolTip="TuringDesk 控制中心"><local:ShellIcon Kind="Agent" Width="19" Height="19" Foreground="#9DAAFF"/></Button>
            <Button Grid.Column="3" Width="40" Height="42" Padding="0" Click="TaskSwitcher_Click" ToolTip="任务切换 · Ctrl+Alt+Space"><local:ShellIcon Kind="Tasks" Width="19" Height="19" Foreground="#AAB4C8"/></Button>

            <ItemsControl Grid.Column="4" ItemsSource="{Binding PinnedApps}" Margin="3,0,6,0" VerticalAlignment="Center">
                <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button Tag="{Binding Target}" Click="Pinned_Click" MouseRightButtonUp="Pinned_MouseRightButtonUp" PreviewMouseLeftButtonDown="Pinned_PreviewMouseLeftButtonDown" PreviewMouseMove="Pinned_PreviewMouseMove" Drop="Pinned_Drop" AllowDrop="True" Width="40" Height="42" Padding="0" Margin="0,0,3,0" ToolTip="{Binding Name}">
                            <Grid>
                                <Image Source="{Binding Icon}" Width="22" Height="22" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/>
                                <local:ShellIcon Kind="App" Width="19" Height="19" Foreground="#AAB4C8" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <local:ShellIcon.Style>
                                        <Style TargetType="local:ShellIcon"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Icon}" Value="{x:Null}"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style>
                                    </local:ShellIcon.Style>
                                </local:ShellIcon>
                            </Grid>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <ScrollViewer Grid.Column="5" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled" Margin="0,0,8,0">
                <ItemsControl ItemsSource="{Binding Tasks}">
                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Tag="{Binding Handle}" Click="Task_Click" MouseRightButtonUp="Task_MouseRightButtonUp" Height="42" MinWidth="54" MaxWidth="168" Margin="0,0,5,0" Padding="8,0" ToolTip="{Binding Title}">
                                <Grid>
                                    <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="3"/></Grid.RowDefinitions>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center"><Image Source="{Binding Icon}" Width="20" Height="20" Margin="0,0,7,0" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/><TextBlock Text="{Binding ShortTitle}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" FontSize="11.5"/></StackPanel>
                                    <Border Grid.Row="1" Height="2" CornerRadius="1" Background="#8190FF" Opacity="{Binding ActiveOpacity}" Margin="6,0"/>
                                </Grid>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <Border Grid.Column="6" Height="42" Background="#1B202B" BorderBrush="#35405B" BorderThickness="1" CornerRadius="9" Margin="0,0,8,0">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="76"/><ColumnDefinition Width="*"/><ColumnDefinition Width="40"/></Grid.ColumnDefinitions>
                    <local:AgentStatusBadge Margin="3"/>
                    <TextBox Grid.Column="1" x:Name="AgentBox" BorderThickness="0" Background="Transparent" Padding="3,8" VerticalContentAlignment="Center" KeyDown="AgentBox_KeyDown" ToolTip="直接告诉图灵你想做什么"/>
                    <Button Grid.Column="2" Margin="4" Padding="0" Click="AgentSend_Click" ToolTip="发送给图灵"><local:ShellIcon Kind="ArrowRight" Width="17" Height="17" Foreground="#B7C1D5"/></Button>
                </Grid>
            </Border>

            <StackPanel Grid.Column="7" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <Button x:Name="NetworkButton" Width="38" Height="38" Padding="0" Click="Network_Click" ToolTip="网络">
                    <Grid Width="20" Height="20">
                        <TextBlock x:Name="NetworkGlyph" Visibility="Collapsed" Foreground="#54D68A"/>
                        <local:ShellIcon Kind="Network" Width="18" Height="18" Foreground="#AAB4C8" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        <Border x:Name="NetworkStateDot" Width="6" Height="6" CornerRadius="3" Background="{Binding Foreground, ElementName=NetworkGlyph}" HorizontalAlignment="Right" VerticalAlignment="Bottom" BorderBrush="#101319" BorderThickness="1"/>
                    </Grid>
                </Button>
                <Button Width="38" Height="38" Padding="0" Click="Volume_Click" ToolTip="声音设置"><local:ShellIcon Kind="Volume" Width="18" Height="18" Foreground="#AAB4C8"/></Button>
                <Button x:Name="PowerButton" Width="46" Height="38" Padding="0" Click="Power_Click" ToolTip="电源"><StackPanel Orientation="Horizontal" HorizontalAlignment="Center"><local:ShellIcon Kind="Power" Width="15" Height="15" Foreground="#AAB4C8" Margin="0,0,3,0"/><TextBlock x:Name="PowerText" Text="AC" FontSize="9.5" VerticalAlignment="Center"/></StackPanel></Button>
            </StackPanel>

            <Button Grid.Column="8" Width="38" Height="38" Padding="0" Click="Settings_Click" ToolTip="桌面 DIY 中心"><local:ShellIcon Kind="Settings" Width="18" Height="18" Foreground="#B5BED0"/></Button>

            <Button Grid.Column="9" Width="38" Height="38" Padding="0" Click="Notifications_Click" ToolTip="TuringDesk 通知中心">
                <Grid Width="20" Height="20"><local:ShellIcon Kind="Notification" Width="18" Height="18" Foreground="#AAB4C8" HorizontalAlignment="Center" VerticalAlignment="Center"/><Border x:Name="NotificationDot" Width="7" Height="7" CornerRadius="4" Background="#8E9CFF" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-1,-1,0" Visibility="Collapsed" BorderBrush="#101319" BorderThickness="1"/></Grid>
            </Button>

            <StackPanel Grid.Column="10" VerticalAlignment="Center" Margin="0,0,7,0"><TextBlock x:Name="ClockText" Text="--:--" FontWeight="SemiBold" HorizontalAlignment="Right" FontSize="11.5"/><TextBlock x:Name="DateText" Text="----/--/--" FontSize="9" Foreground="#8A95AA" HorizontalAlignment="Right"/></StackPanel>
            <Button Grid.Column="11" Width="40" Height="42" Padding="0" Click="Session_Click" ToolTip="会话与电源"><local:ShellIcon Kind="Power" Width="18" Height="18" Foreground="#D6A76F"/></Button>
        </Grid>
    </Border>
</Window>