<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>TuringDesk.Desktop</AssemblyName>
    <RootNamespace>TuringDesk.Desktop</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <TuringDeskApplicationIcon>$(MSBuildProjectDirectory)\$(IntermediateOutputPath)TuringDesk.ico</TuringDeskApplicationIcon>
    <ApplicationIcon>$(TuringDeskApplicationIcon)</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4078.44" />
    <PackageReference Include="System.Speech" Version="8.0.0" />
    <PackageReference Include="Vortice.Wpf" Version="3.8.3" />
    <PackageReference Include="NAudio" Version="2.3.0" />
    <PackageReference Include="Jint" Version="4.15.2" />
    <PackageReference Include="PinyinNet" Version="1.0.0" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="ThirdParty\Everything\**\*"
             CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="PreserveNewest" />
    <Content Include="..\..\THIRD-PARTY-NOTICES.md"
             Link="ThirdParty\THIRD-PARTY-NOTICES.md"
             CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <Target Name="GenerateTuringDeskApplicationIcon"
          BeforeTargets="CoreCompile"
          Inputs="$(MSBuildProjectDirectory)\..\..\scripts\generate-brand-icon.ps1"
          Outputs="$(TuringDeskApplicationIcon)">
    <Exec Command="powershell.exe -NoProfile -ExecutionPolicy Bypass -File &quot;$(MSBuildProjectDirectory)\..\..\scripts\generate-brand-icon.ps1&quot; -OutputPath &quot;$(TuringDeskApplicationIcon)&quot;" />
  </Target>
</Project>